+void InputEventHandler::IgnoreNextSleepButtonPress(
+    const base::TimeDelta& timeout) {
+  if (timeout.is_zero()) {
+    VLOG(1) << "Cancel sleep button press discarding";
+    ignore_sleep_button_deadline_ = base::TimeTicks();
+    sleep_button_down_ignored_ = false;
+  } else {
+    VLOG(1) << "Ignoring sleep button for " << timeout.InMilliseconds()
+            << " ms";
+    ignore_sleep_button_deadline_ = clock_->GetCurrentTime() + timeout;
+  }
+}

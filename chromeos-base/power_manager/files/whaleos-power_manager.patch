+// WhaleOS: only Waydroid's LXC freezer cgroups are exempt from userspace
+// freeze; other lxc.* cgroups (dev/debug containers, other LXC payloads)
+// must still freeze along with the rest of userspace.
+TEST_F(SuspendFreezerTest, TestWaydroidLxcExclusionScope) {
+  const base::FilePath waydroid_payload_state =
+      base::FilePath("/sys/fs/cgroup/freezer/lxc.payload.waydroid")
+          .Append(kStateFile);
+  const base::FilePath waydroid_monitor_state =
+      base::FilePath("/sys/fs/cgroup/freezer/lxc.monitor.waydroid")
+          .Append(kStateFile);
+  const base::FilePath debug_payload_state =
+      base::FilePath("/sys/fs/cgroup/freezer/lxc.payload.debug")
+          .Append(kStateFile);
+  const base::FilePath debug_monitor_state =
+      base::FilePath("/sys/fs/cgroup/freezer/lxc.monitor.debug")
+          .Append(kStateFile);
+  // Same-prefix decoys: names that would sneak through a StartsWith
+  // ("lxc.payload.waydroid") check but must NOT be treated as Waydroid.
+  const base::FilePath waydroid_prefix_debug_state =
+      base::FilePath("/sys/fs/cgroup/freezer/lxc.payload.waydroid-debug")
+          .Append(kStateFile);
+  const base::FilePath waydroid_prefix_v2_state =
+      base::FilePath("/sys/fs/cgroup/freezer/lxc.monitor.waydroid2")
+          .Append(kStateFile);
+  const base::FilePath other_state =
+      base::FilePath("/sys/fs/cgroup/freezer/other_group").Append(kStateFile);
+
+  mock_sys_utils_->file_contents_[waydroid_payload_state] = kFreezerStateThawed;
+  mock_sys_utils_->file_contents_[waydroid_monitor_state] = kFreezerStateThawed;
+  mock_sys_utils_->file_contents_[debug_payload_state] = kFreezerStateThawed;
+  mock_sys_utils_->file_contents_[debug_monitor_state] = kFreezerStateThawed;
+  mock_sys_utils_->file_contents_[waydroid_prefix_debug_state] =
+      kFreezerStateThawed;
+  mock_sys_utils_->file_contents_[waydroid_prefix_v2_state] =
+      kFreezerStateThawed;
+  mock_sys_utils_->file_contents_[other_state] = kFreezerStateThawed;
+
+  EXPECT_EQ(FreezeResult::SUCCESS, suspend_freezer_.FreezeUserspace(1, true));
+
+  // Waydroid cgroups: skipped, so still Thawed.
+  EXPECT_EQ(kFreezerStateThawed,
+            mock_sys_utils_->file_contents_[waydroid_payload_state]);
+  EXPECT_EQ(kFreezerStateThawed,
+            mock_sys_utils_->file_contents_[waydroid_monitor_state]);
+  // Other LXC containers and non-LXC cgroups: frozen as usual.
+  EXPECT_EQ(kFreezerStateFrozen,
+            mock_sys_utils_->file_contents_[debug_payload_state]);
+  EXPECT_EQ(kFreezerStateFrozen,
+            mock_sys_utils_->file_contents_[debug_monitor_state]);
+  // Same-prefix decoys: exact-match rule must NOT exempt these.
+  EXPECT_EQ(kFreezerStateFrozen,
+            mock_sys_utils_->file_contents_[waydroid_prefix_debug_state]);
+  EXPECT_EQ(kFreezerStateFrozen,
+            mock_sys_utils_->file_contents_[waydroid_prefix_v2_state]);
+  EXPECT_EQ(kFreezerStateFrozen, mock_sys_utils_->file_contents_[other_state]);
+  EXPECT_EQ(kFreezerStateFrozen, mock_sys_utils_->file_contents_[test_state_]);
+
+  EXPECT_TRUE(suspend_freezer_.ThawProcesses());
+}

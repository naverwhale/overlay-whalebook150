+void InputEventHandler::OnSleepButtonEvent(ButtonState state) {
+  if (factory_mode_) {
+    LOG(INFO) << "Ignoring sleep button " << ButtonStateToString(state)
+              << " for factory mode";
+    return;
+  }
+
+  if (clock_->GetCurrentTime() < ignore_sleep_button_deadline_) {
+    bool ignore = state == ButtonState::DOWN || sleep_button_down_ignored_;
+    if (state == ButtonState::UP)  // Consumed, we no longer need the deadline.
+      IgnoreNextSleepButtonPress(base::TimeDelta());
+    else if (state == ButtonState::DOWN)
+      sleep_button_down_ignored_ = true;
+    if (ignore) {
+      // Ignore down event or up event if it matches a down event.
+      LOG(INFO) << "Ignored sleep button " << ButtonStateToString(state);
+      // Do not forward this event.
+      return;
+    }
+  }
+
+  delegate_->HandleSleepButtonEvent(state);
+}

+bool UpdateMiniosKernel(const InstallConfig& install_config) {
+  const base::FilePath root_mount(install_config.root.mount());
+  const base::FilePath boot_mount(install_config.boot.mount());
+
+  const base::FilePath kernel_from = root_mount.Append("boot").Append("syslinux").Append("vmlinuz.minios");
+  const base::FilePath kernel_to =
+      boot_mount.Append("syslinux").Append("vmlinuz.minios");
+
+  if (base::PathExists(kernel_from))
+    return base::CopyFile(kernel_from, kernel_to);
+
+  PLOG(WARNING) << "There are no vmlinuz.minios in efi partition";
+
+  return true;
+}
+
+bool UpdateFW(const InstallConfig& install_config) {
+  const base::FilePath root_mount(install_config.root.mount());
+  const base::FilePath fw_dir = root_mount.Append("usr")
+      .Append("share").Append("whaleos_fw");
+
+  if (!base::PathExists(fw_dir)) {
+    PLOG(WARNING) << __func__ << ": There are no fw updater.";
+    return true;
+  }
+
+  std::string file_content, target_model, target_server;
+  base::ReadFileToString(fw_dir.Append("target"), &file_content);
+  base::TrimWhitespaceASCII(file_content, base::TRIM_ALL, &target_model);
+  base::ReadFileToString(fw_dir.Append("server"), &file_content);
+  base::TrimWhitespaceASCII(file_content, base::TRIM_ALL, &target_server);
+
+  string result_string;
+  if (LsbReleaseValue(root_mount.Append("etc/lsb-release"),
+        "CHROMEOS_RELEASE_TRACK", &result_string) && result_string != target_server) {
+    LOG(INFO) << __func__ << ": " << result_string << " is not a target server, skip fw update.";
+    return true;
+  }
+
+  bool need_update = false;
+  for (const std::string& model : base::SplitString(
+        target_model, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (base::StartsWith(brillo::GetProductName(), model,
+                         base::CompareCase::SENSITIVE)) {
+      need_update = true;
+      break;
+    }
+  }
+
+  if (need_update) {
+    LOG(INFO) << __func__ << ": Try to FW update.";
+
+    if (RunCommand({fw_dir.Append("update_firmware.sh").value(), fw_dir.value()}) != 0) {
+      PLOG(ERROR) << __func__ << ": Failed to run update script.";
+      return false;
+    }
+  } else {
+    LOG(INFO) << __func__ << ": It's not target model.";
+  }
+
+  return true;
+}
+
+bool UpdateBIOS(const InstallConfig& install_config) {
+  const base::FilePath root_mount(install_config.root.mount());
+  const base::FilePath bios_dir = root_mount.Append("usr")
+      .Append("share").Append("whaleos_bios");
+
+  if (!base::PathExists(bios_dir)) {
+    PLOG(WARNING) << __func__ << ": There are no bios updater.";
+    return true;
+  }
+
+  std::string file_content, target_server, target_model, next_version;
+  base::ReadFileToString(bios_dir.Append("target"), &file_content);
+  base::TrimWhitespaceASCII(file_content, base::TRIM_ALL, &target_model);
+  base::ReadFileToString(bios_dir.Append("version"), &file_content);
+  base::TrimWhitespaceASCII(file_content, base::TRIM_ALL, &next_version);
+  base::ReadFileToString(bios_dir.Append("server"), &file_content);
+  base::TrimWhitespaceASCII(file_content, base::TRIM_ALL, &target_server);
+
+  string result_string;
+  if (LsbReleaseValue(root_mount.Append("etc/lsb-release"),
+        "CHROMEOS_RELEASE_TRACK", &result_string) && result_string != target_server) {
+    LOG(INFO) << __func__ << ": " << result_string << " is not a target server, skip bios update.";
+    return true;
+  }
+
+  bool need_update = false;
+  for (const std::string& model : base::SplitString(
+        target_model, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (brillo::GetProductName() == model &&
+        brillo::GetBiosVersion().compare(next_version) < 0) {
+      need_update = true;
+      break;
+    }
+  }
+
+  if (need_update) {
+    LOG(INFO) << __func__ << ": Try to BIOS update.";
+
+    if (RunCommand({bios_dir.Append("fw_upd_prepare.sh").value(), bios_dir.value()}) != 0) {
+      PLOG(ERROR) << __func__ << ": Failed to run update script.";
+    } else {
+      LOG(INFO) << __func__ << ": BIOS will be updated after rebooting";
+    }
+  } else {
+    LOG(INFO) << __func__ << ": It's not target model or it has Already latest version";
+  }
+
+  return true;
+}

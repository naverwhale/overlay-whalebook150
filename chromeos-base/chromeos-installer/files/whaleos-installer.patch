+void CleanupEfi(const InstallConfig& install_config) {
+  const base::FilePath boot_mount(install_config.boot.mount());
+  const base::FilePath fw_dir = boot_mount.Append("efi").Append("boot").Append("fw");
+  const base::FilePath fws_dir = boot_mount.Append("syslinux").Append("fws");
+  const base::FilePath bios_dir = boot_mount.Append("syslinux").Append("bios_upd");
+
+  if (base::PathExists(fw_dir)) {
+    if(!brillo::DeletePathRecursively(fw_dir)) {
+      LOG(INFO) << "Failed to cleanup " << fw_dir;
+    } else {
+      LOG(INFO) << "Cleanup " << fw_dir;
+    }
+  }
+
+  if (base::PathExists(fws_dir)) {
+    if(!brillo::DeletePathRecursively(fws_dir)) {
+      LOG(INFO) << "Failed to cleanup " << fws_dir;
+    } else {
+      LOG(INFO) << "Cleanup " << fws_dir;
+    }
+  }
+
+  if (base::PathExists(bios_dir)) {
+    if(!brillo::DeletePathRecursively(bios_dir)) {
+      LOG(INFO) << "Failed to cleanup " << bios_dir;
+    } else {
+      LOG(INFO) << "Cleanup " << bios_dir;
+    }
+  }
+}
+
 bool RunEfiPostInstall(const Platform& platform,
                        const InstallConfig& install_config) {
   LOG(INFO) << "Running EfiPostInstall.";
 
+  CleanupEfi(install_config);
+
   // Update the kernel we are about to use.
   if (!UpdateLegacyKernel(install_config)) {
     return false;
   }
 
+  // Update the vmlinuz.minios for Whalebook
+  if (!UpdateMiniosKernel(install_config)) {
+    return false;
+  }
+
   if (!UpdateEfiBootloaders(platform, install_config)) {
     return false;
   }
@@ -470,6 +624,28 @@ bool RunEfiPostInstall(const Platform& platform,
     return false;
   }
 
+  string kernel_cmd_line;
+  if (!base::ReadFileToString(base::FilePath("/proc/cmdline"),
+                              &kernel_cmd_line)) {
+    LOG(WARNING) << "Can't read kernel commandline options"
+                 << "Skip update FWs and BIOS";
+    return true;
+  }
+
+  bool is_minios = kernel_cmd_line.find("cros_minios") != string::npos;
+
+  // Skip update FW or BIOS when install from usb or minios
+  if (install_config.is_install || is_minios) {
+    LOG(INFO) << "It's not update, skip update FWs and BIOS";
+    return true;
+  }
+
+  if (!UpdateFW(install_config))
+    return false;
+
+  if (!UpdateBIOS(install_config))
+    return false;
+
   // We finished.
   return true;
 }

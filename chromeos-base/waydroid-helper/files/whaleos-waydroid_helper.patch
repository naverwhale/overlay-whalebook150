+// found in the LICENSE file.
+
+#ifndef WAYDROID_HELPER_APK_METADATA_H_
+#define WAYDROID_HELPER_APK_METADATA_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include <base/files/file_path.h>
+
+namespace waydroid_helper {
+
+struct ApkMetadata {
+  // From AndroidManifest.xml <manifest package="…">.  Required -- if we
+  // couldn't derive it, ExtractApkMetadata() returns nullopt.
+  std::string package_id;
+
+  // Application label if it appears in AndroidManifest.xml as a literal
+  // (`android:label="Whale"`).  Empty when the manifest references a
+  // resource (@string/app_name) -- resolving that would require parsing
+  // resources.arsc, which we skip until there's a proven need.  Callers
+  // should fall back to something else (e.g. the CLI's ListApps output or
+  // package_id) when this is empty.
+  std::string label;
+
+  // A launcher icon extracted straight from the APK zip -- we scan
+  // res/mipmap-*/ and res/drawable-*/ for `ic_launcher.png` (or
+  // `.webp`) and keep the highest-density match.  Empty when nothing
+  // recognisable is found; PNG data otherwise.
+  std::vector<uint8_t> icon_png;
+};
+
+// Reads the APK at `apk_path` and returns its metadata, or nullopt if the
+// file isn't a valid APK / we can't even read its package name.  Safe to
+// call on untrusted input: everything is size-bounded and no code from the
+// APK is executed.
+std::optional<ApkMetadata> ExtractApkMetadata(const base::FilePath& apk_path);
+
+}  // namespace waydroid_helper
+
+#endif  // WAYDROID_HELPER_APK_METADATA_H_

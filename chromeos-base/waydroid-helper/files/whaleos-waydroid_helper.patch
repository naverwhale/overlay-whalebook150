@@ -0,0 +1,22 @@
+<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
+ "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
+<!--
+  Copyright 2026 NAVER Authors. All rights reserved.
+  Use of this source code is governed by a BSD-style license that can be
+  found in the LICENSE file.
+
+  System-bus policy for id.waydro.Helper.  The daemon runs as root because
+  `waydroid` CLI itself requires root for LXC operations; chronos (Chrome)
+  is allowed to call the four methods.
+-->
+<busconfig>
+  <policy user="root">
+    <allow own="id.waydro.Helper"/>
+    <allow send_destination="id.waydro.Helper"
+           send_interface="id.waydro.Helper"/>
+  </policy>
+  <policy user="chronos">
+    <allow send_destination="id.waydro.Helper"
+           send_interface="id.waydro.Helper"/>
+  </policy>
+</busconfig>
diff --git a/waydroid_helper/dbus_bindings/id.waydro.Helper.xml b/waydroid_helper/dbus_bindings/id.waydro.Helper.xml
new file mode 100644
index 0000000000..f767f43115
--- /dev/null
+++ b/waydroid_helper/dbus_bindings/id.waydro.Helper.xml
@@ -0,0 +1,151 @@
+<?xml version="1.0" encoding="UTF-8" ?>
+<!--
+  Copyright 2026 NAVER Authors. All rights reserved.
+  Use of this source code is governed by a BSD-style license that can be
+  found in the LICENSE file.
+
+  D-Bus interface exposed by waydroid-helper, a thin host-side daemon that
+  proxies app management requests from Chrome's WaydroidApps publisher (and
+  the Files app .apk handler) to the Waydroid container's `waydroid app`
+  CLI.  The daemon performs three responsibilities:
+
+    1. Translates D-Bus method calls into `waydroid app {list,install,
+       remove,launch}` subprocess invocations.
+    2. Filters the LineageOS pre-installed apps out of `ListApps` so the
+       ChromeOS launcher only shows user-installed apps.
+    3. Exits after a short idle timeout so the daemon has no background
+       cost; subsequent calls re-spawn it via D-Bus activation.
+
+  Naming convention follows the existing Waydroid project ones we already
+  ship: id.waydro.Container (lifecycle) and id.waydro.Session (per-user
+  bus).  This adds id.waydro.Helper for app management.
+-->
+<node name="/id/waydro/Helper"
+    xmlns:tp="http://telepathy.freedesktop.org/wiki/DbusSpec#extensions-v0">
+  <interface name="id.waydro.Helper">
+    <method name="IsRunning">
+      <tp:docstring>
+        Quick non-blocking check whether the Waydroid LXC container is up.
+        Chrome calls this before LaunchApp to decide whether to show a
+        "Starting Android..." spinner.
+      </tp:docstring>
+      <arg name="running" type="b" direction="out"/>
+      <annotation name="org.chromium.DBus.Method.Kind" value="simple"/>
+    </method>
+
+    <method name="EnsureRunning">
+      <tp:docstring>
+        Block until the container is running AND Android has finished
+        booting (sys.boot_completed=1).  Idempotent: returns success
+        immediately if already running.  Returns (false, error_message)
+        on timeout (~30s) or upstart/container failure.  This is the
+        right call to make from Chrome's WaydroidApps publisher right
+        before any user-visible action that requires the container.
+      </tp:docstring>
+      <arg name="success" type="b" direction="out"/>
+      <arg name="error_message" type="s" direction="out"/>
+      <annotation name="org.chromium.DBus.Method.Kind" value="simple"/>
+    </method>
+
+    <method name="ListApps">
+      <tp:docstring>
+        Return all user-installed Waydroid apps (pre-installed LineageOS apps
+        are filtered server-side).  Each entry is (display_name, package_id,
+        icon_png_bytes).  icon_png_bytes is allowed to be empty if the
+        daemon could not extract the launcher icon.
+
+        IMPORTANT (lazy-start): this method does NOT auto-start the
+        container.  If the container is stopped, the daemon returns the
+        cached list from the last successful query while the container was
+        up.  The launcher therefore stays responsive at login while the
+        container itself only boots when the user actually picks an app.
+      </tp:docstring>
+      <arg name="apps" type="a(ssay)" direction="out"/>
+      <annotation name="org.chromium.DBus.Method.Kind" value="simple"/>
+    </method>
+
+    <method name="InstallApk">
+      <tp:docstring>
+        Install an APK file located at |apk_path| (must be readable by the
+        daemon's user).  Blocks until install completes.  Returns success +
+        error message (empty on success).
+      </tp:docstring>
+      <arg name="apk_path" type="s" direction="in"/>
+      <arg name="success" type="b" direction="out"/>
+      <arg name="error_message" type="s" direction="out"/>
+      <annotation name="org.chromium.DBus.Method.Kind" value="simple"/>
+    </method>
+
+    <method name="RemoveApp">
+      <tp:docstring>
+        Uninstall the app identified by |package_id|.  Returns success.
+      </tp:docstring>
+      <arg name="package_id" type="s" direction="in"/>
+      <arg name="success" type="b" direction="out"/>
+      <annotation name="org.chromium.DBus.Method.Kind" value="simple"/>
+    </method>
+
+    <method name="LaunchApp">
+      <tp:docstring>
+        Launch the main activity of |package_id|.  Returns success.  The
+        actual window appears via the Waydroid Wayland surface managed by
+        the container's hwcomposer.
+
+        Implicitly bumps the container's cgroup CPU shares to foreground
+        as a safety net for callers that haven't wired up window-focus
+        tracking yet; callers that have should also call SetBackground
+        when their last Android window loses focus / closes.
+      </tp:docstring>
+      <arg name="package_id" type="s" direction="in"/>
+      <arg name="success" type="b" direction="out"/>
+      <annotation name="org.chromium.DBus.Method.Kind" value="simple"/>
+    </method>
+
+    <method name="SetForeground">
+      <tp:docstring>
+        Raise the LXC payload cgroup's cpu.shares to the foreground value
+        (matches ChromeOS Chrome processes).  Chrome's WaydroidApps
+        publisher should call this when an Android Wayland surface gains
+        focus -- including focus on an already-running Android app
+        (in which case no LaunchApp is issued, but the user still wants
+        full CPU priority).  Returns false if the container cgroup is not
+        present (container not running).
+      </tp:docstring>
+      <arg name="success" type="b" direction="out"/>
+      <annotation name="org.chromium.DBus.Method.Kind" value="simple"/>
+    </method>
+
+    <method name="SetBackground">
+      <tp:docstring>
+        Drop the LXC payload cgroup's cpu.shares to the background value
+        (~16x lower than foreground -- ARC++ kCpuRestrictionBackground
+        equivalent).  Chrome's publisher should call this when its last
+        Android window loses focus or is closed, so Android's background
+        services stop competing with the ChromeOS UI for CPU.  Returns
+        false if the container cgroup is not present.
+      </tp:docstring>
+      <arg name="success" type="b" direction="out"/>
+      <annotation name="org.chromium.DBus.Method.Kind" value="simple"/>
+    </method>
+
+    <signal name="ContainerStateChanged">
+      <tp:docstring>
+        Fired when the helper observes the container transition between
+        "running with Android booted" and "stopped".  |running| reflects
+        the new state.  Subscribers can use this to invalidate their
+        view of the app list, or to show a "Starting Android..." UI
+        without polling IsRunning.
+      </tp:docstring>
+      <arg name="running" type="b"/>
+    </signal>
+
+    <signal name="AppListChanged">
+      <tp:docstring>
+        Fired after a successful InstallApk or RemoveApp.  Subscribers
+        should call ListApps to refetch the current set.  No argument
+        because the daemon already cached the list internally and
+        ListApps is cheap.
+      </tp:docstring>
+    </signal>
+  </interface>
+</node>
diff --git a/waydroid_helper/init/waydroid-helper.conf b/waydroid_helper/init/waydroid-helper.conf
new file mode 100644
index 0000000000..4f4a24151c
--- /dev/null
+++ b/waydroid_helper/init/waydroid-helper.conf
@@ -0,0 +1,34 @@
+# Copyright 2026 NAVER Authors. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+description     "WhaleOS Waydroid app management D-Bus helper"
+author          "whaleos-dev@navercorp.com"
+
+# Starts alongside other system services.  The daemon is cheap (idle most
+# of the time and gated by lazy-start on the container side) so D-Bus
+# activation isn't set up -- the constant overhead of one long-lived
+# process isn't worth the extra complexity of the activation glue.
+start on started system-services
+stop on stopping system-services
+
+# Bail if respawning too fast (e.g. waydroid binary missing).
+respawn
+respawn limit 10 10
+
+oom score -100
+
+# The `waydroid` Python CLI we shell out to from SuspendCoordinator
+# (EnterDoze / ExitDoze) imports gi.repository.GLib via PyGObject for
+# its Binder client.  Without GI_TYPELIB_PATH the import fails with
+# "cannot import name GLib, introspection typelib not found" and our
+# Doze hand-off no-ops at every SuspendImminent.  Same env that
+# waydroid-container.conf sets, kept in sync.  libgbinder /
+# python-gbinder live under /usr/local/lib64 on WhaleOS dev images.
+env LD_LIBRARY_PATH=/usr/local/lib64
+env GI_TYPELIB_PATH=/usr/lib64/girepository-1.0
+
+# Daemon runs as root because the underlying `waydroid` CLI requires root
+# for LXC operations.  No minijail wrapper yet -- to be tightened in a
+# follow-up once the call surface and seccomp policy are stable.
+exec /usr/sbin/waydroid_helper

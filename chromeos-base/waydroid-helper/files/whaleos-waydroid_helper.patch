--- /dev/null
+++ b/waydroid_helper/daemon.cc
@@ -0,0 +1,414 @@
+// Copyright 2026 NAVER Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "waydroid_helper/daemon.h"
+
+#include <sysexits.h>
+
+#include <algorithm>
+#include <utility>
+
+#include <base/files/file_path.h>
+#include <base/files/file_util.h>
+#include <base/logging.h>
+#include <base/time/time.h>
+#include <dbus/bus.h>
+#include <dbus/object_path.h>
+
+namespace waydroid_helper {
+
+namespace {
+// Path matches the one declared in id.waydro.Helper.xml.
+constexpr char kObjectPath[] = "/id/waydro/Helper";
+
+// Where we stash per-package launcher icons extracted at InstallApk time.
+// Sits under the same encrypted-stateful mount as the TSV app cache so both
+// survive reboots on the same disk.
+constexpr char kIconDir[] = "/var/lib/waydroid_helper/icons";
+
+// Android package names allow letters, digits, '.' and '_'.  Refuse
+// anything else so nobody can talk us into path-traversal via a crafted
+// package id.
+bool IsSafePackageId(const std::string& package_id) {
+  if (package_id.empty() || package_id.size() > 256) {
+    return false;
+  }
+  for (char c : package_id) {
+    const bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                    (c >= '0' && c <= '9') || c == '.' || c == '_';
+    if (!ok) {
+      return false;
+    }
+  }
+  return true;
+}
+
+base::FilePath IconPathForPackage(const std::string& package_id) {
+  return base::FilePath(kIconDir).Append(package_id + ".png");
+}
+}  // namespace
+
+DBusAdaptor::DBusAdaptor(scoped_refptr<dbus::Bus> bus)
+    : id::waydro::HelperAdaptor(this),
+      dbus_object_(/*object_manager=*/nullptr,
+                   bus,
+                   dbus::ObjectPath(kObjectPath)) {}
+
+void DBusAdaptor::RegisterAsync(
+    brillo::dbus_utils::AsyncEventSequencer::CompletionAction cb) {
+  RegisterWithDBusObject(&dbus_object_);
+  dbus_object_.RegisterAsync(std::move(cb));
+
+  // Start the boot watcher: every 5s, check whether Android has booted;
+  // when it has, drop to background CPU shares once and stop polling.
+  // 5s is plenty light (each tick is one `lxc-attach getprop` of a few
+  // hundred ms, gated by a 3s timeout); the watcher stops itself the
+  // moment background is applied so steady-state cost is zero.
+  boot_watcher_.Start(FROM_HERE, base::Seconds(5),
+                      base::BindRepeating(&DBusAdaptor::OnBootWatcherTick,
+                                          weak_factory_.GetWeakPtr()));
+}
+
+void DBusAdaptor::OnBootWatcherTick() {
+  if (background_applied_) {
+    boot_watcher_.Stop();
+    return;
+  }
+  if (!cli_.IsRunning() || !cli_.IsBootCompleted()) {
+    return;
+  }
+  if (cli_.SetCpuShares(WaydroidCli::kCpuSharesBackground)) {
+    LOG(INFO) << "Boot complete; dropped Waydroid cpu.shares to background ("
+              << WaydroidCli::kCpuSharesBackground << ")";
+    background_applied_ = true;
+    boot_watcher_.Stop();
+    // Kick a background refresh: boot_completed=1 doesn't guarantee that
+    // Android's `waydroidplatform` binder service is registered yet, so the
+    // ticker will keep retrying `waydroid app list` until it succeeds and
+    // then emit AppListChanged exactly once with the live data.
+    ScheduleRefreshCache(base::Seconds(0));
+  }
+}
+
+void DBusAdaptor::ScheduleRefreshCache(base::TimeDelta initial_delay) {
+  refresh_attempts_ = 0;
+  refresh_timer_.Start(FROM_HERE, initial_delay,
+                       base::BindOnce(&DBusAdaptor::RefreshCacheTick,
+                                      weak_factory_.GetWeakPtr()));
+}
+
+void DBusAdaptor::RefreshCacheTick() {
+  // Backoff cadence: try every 3s for up to ~90s.  `waydroid app list`
+  // itself has a 5s internal timeout so a single failed attempt costs at
+  // most 5s of daemon-thread time; we're fine to serialize this with D-Bus
+  // handling.
+  constexpr int kMaxAttempts = 30;
+  constexpr base::TimeDelta kInterval = base::Seconds(3);
+
+  refresh_attempts_++;
+
+  std::optional<std::vector<WaydroidCli::App>> fresh = cli_.ListApps();
+  if (fresh.has_value()) {
+    // CLI ran to completion.  Merge with placeholders seeded by
+    // InstallApk that Android's `waydroid app list` hasn't caught up to
+    // yet: right after `pm install` the target usually shows up in a
+    // subsequent `waydroid app list` roundtrip, but there's a several-
+    // second window where the list still enumerates only the pre-baked
+    // LineageOS system apps.  Those all get blocklisted, so `fresh`
+    // comes back as `Some({})` and unconditionally saving it would blow
+    // away the placeholder we just seeded (and the launcher tile would
+    // vanish until the next refresh).
+    //
+    // Ground truth for "the user recently installed this" is the icon
+    // file on disk: SaveIconForPackage runs only after cli_.InstallApk
+    // returned success, so if we still have an icon PNG on disk but
+    // fresh doesn't list its package, that package is real and in
+    // flight.  Preserve those entries verbatim from the previous cache
+    // until fresh starts including them (at which point the natural
+    // dedupe by package_id keeps a single copy).
+    std::vector<WaydroidCli::App> merged = std::move(*fresh);
+    const std::vector<WaydroidCli::App> old_cache = cache_.Load();
+    for (const auto& old_app : old_cache) {
+      const bool in_fresh = std::any_of(
+          merged.begin(), merged.end(),
+          [&](const WaydroidCli::App& m) {
+            return m.package_id == old_app.package_id;
+          });
+      if (in_fresh) {
+        continue;
+      }
+      if (!base::PathExists(IconPathForPackage(old_app.package_id))) {
+        // No icon on disk = never seeded by us; must be either a stale
+        // entry we've since uninstalled or a pre-existing cache row from
+        // an older daemon build.  Drop it so uninstalls converge.
+        continue;
+      }
+      merged.push_back(old_app);
+    }
+    cache_.Save(std::move(merged));
+    SendAppListChangedSignal();
+    return;
+  }
+
+  if (refresh_attempts_ < kMaxAttempts) {
+    refresh_timer_.Start(FROM_HERE, kInterval,
+                         base::BindOnce(&DBusAdaptor::RefreshCacheTick,
+                                        weak_factory_.GetWeakPtr()));
+  } else {
+    LOG(WARNING) << "RefreshCache: gave up after " << kMaxAttempts
+                 << " attempts; launcher may be stale until the next "
+                    "container-state change";
+  }
+}
+
+void DBusAdaptor::MaybeEmitContainerStateChanged(bool observed) {
+  if (observed == last_known_running_) {
+    return;
+  }
+  last_known_running_ = observed;
+  SendContainerStateChangedSignal(observed);
+  if (observed) {
+    // Container just came up: schedule a cache refresh so the launcher
+    // reflects whatever's actually installed once Android finishes boot.
+    // Any AppListChanged Chrome cares about will be emitted from the
+    // background ticker exactly once the CLI succeeds.
+    ScheduleRefreshCache(base::Seconds(1));
+  }
+}
+
+bool DBusAdaptor::IsRunning() {
+  const bool running = cli_.IsRunning();
+  MaybeEmitContainerStateChanged(running);
+  return running;
+}
+
+void DBusAdaptor::EnsureRunning(bool* success, std::string* error_message) {
+  std::string err;
+  bool ok = cli_.EnsureRunning(&err);
+  MaybeEmitContainerStateChanged(ok);
+  if (success) {
+    *success = ok;
+  }
+  if (error_message) {
+    *error_message = ok ? std::string() : std::move(err);
+  }
+}
+
+std::vector<std::tuple<std::string, std::string, std::vector<uint8_t>>>
+DBusAdaptor::ListApps() {
+  // Fast path: serve from the on-disk cache.  Any state change that
+  // could have affected the installed-app set (Install/Remove/boot-
+  // complete/container-up) schedules a background RefreshCacheTick which
+  // eventually populates the cache with a live enumeration and re-emits
+  // AppListChanged.  So D-Bus reads are always O(cache_load) and Chrome
+  // gets a follow-up signal once real data is available.
+  //
+  // If the container is currently running AND the cache is empty, take
+  // the opportunity to try one live query synchronously -- this covers
+  // the very-first-boot case where the cache file doesn't exist yet.
+  std::vector<WaydroidCli::App> apps = cache_.Load();
+  if (apps.empty() && cli_.IsRunning()) {
+    std::optional<std::vector<WaydroidCli::App>> fresh = cli_.ListApps();
+    if (fresh.has_value()) {
+      apps = std::move(*fresh);
+      cache_.Save(apps);
+    } else {
+      // Live failed; kick a background refresh so we get real data soon.
+      ScheduleRefreshCache(base::Seconds(0));
+    }
+  }
+
+  std::vector<std::tuple<std::string, std::string, std::vector<uint8_t>>> out;
+  out.reserve(apps.size());
+  for (auto& app : apps) {
+    // `waydroid app list` never fills icon_png (the CLI just doesn't emit
+    // one), so we always overlay whatever InstallApk stashed on disk.  If
+    // no icon was captured -- either the APK didn't ship a launcher PNG
+    // or it was installed before this daemon started tracking icons --
+    // icon_png stays empty and Chrome uses its default resource icon.
+    std::vector<uint8_t> icon = LoadIconForPackage(app.package_id);
+    out.emplace_back(std::move(app.name),
+                     std::move(app.package_id),
+                     std::move(icon));
+    // Suppress unused-value warning on the discarded original icon_png.
+    (void)app.icon_png;
+  }
+  return out;
+}
+
+void DBusAdaptor::InstallApk(const std::string& apk_path,
+                             bool* success,
+                             std::string* error_message) {
+  // Pull the label + icon straight out of the APK BEFORE running the
+  // container-side install.  Two reasons:
+  //   1. We don't want to depend on Android's waydroidplatform binder
+  //      being up to render the launcher entry -- it can lag `pm install`
+  //      by tens of seconds after a fresh container boot.
+  //   2. Even after Android is up, `waydroid app list` returns an empty
+  //      icon_png; extracting from the APK is currently the only way to
+  //      show a real icon in the ChromeOS launcher.
+  // Failure to parse is non-fatal: we still forward the install to the
+  // container CLI and rely on the CLI's app list for name/id.
+  std::optional<ApkMetadata> md =
+      ExtractApkMetadata(base::FilePath(apk_path));
+
+  // Install needs the container; bring it up if not running.
+  std::string ensure_err;
+  if (!cli_.EnsureRunning(&ensure_err)) {
+    if (success) {
+      *success = false;
+    }
+    if (error_message) {
+      *error_message = "container start failed: " + ensure_err;
+    }
+    return;
+  }
+
+  std::string err;
+  bool ok = cli_.InstallApk(apk_path, &err);
+  if (ok) {
+    if (md && !md->package_id.empty()) {
+      // Persist the icon (if any) and pre-seed the on-disk TSV cache with
+      // a placeholder record so Chrome can already draw the launcher tile
+      // during the ~5-30s it takes waydroidplatform to become queryable.
+      // The background RefreshCacheTick will replace this record with the
+      // authoritative one from `waydroid app list` as soon as it succeeds.
+      if (!md->icon_png.empty()) {
+        SaveIconForPackage(md->package_id, md->icon_png);
+      }
+      std::vector<WaydroidCli::App> seeded = cache_.Load();
+      const bool already_cached = std::any_of(
+          seeded.begin(), seeded.end(),
+          [&](const WaydroidCli::App& a) {
+            return a.package_id == md->package_id;
+          });
+      if (!already_cached) {
+        WaydroidCli::App placeholder;
+        placeholder.name =
+            !md->label.empty() ? md->label : md->package_id;
+        placeholder.package_id = md->package_id;
+        seeded.push_back(std::move(placeholder));
+        cache_.Save(seeded);
+        SendAppListChangedSignal();
+      }
+    }
+    // Reply to Chrome right away so the "installing..." notification
+    // resolves.  The background refresh will still run and eventually
+    // replace the seeded entry with the CLI's real record; if
+    // waydroidplatform never comes up, the seeded entry keeps the app
+    // visible in the launcher anyway.
+    ScheduleRefreshCache(base::Seconds(1));
+  }
+  if (success) {
+    *success = ok;
+  }
+  if (error_message) {
+    *error_message = ok ? std::string() : std::move(err);
+  }
+}
+
+bool DBusAdaptor::RemoveApp(const std::string& package_id) {
+  std::string ensure_err;
+  if (!cli_.EnsureRunning(&ensure_err)) {
+    LOG(ERROR) << "RemoveApp(" << package_id
+               << "): container start failed: " << ensure_err;
+    return false;
+  }
+  bool ok = cli_.RemoveApp(package_id);
+  if (ok) {
+    // The stored icon file is now orphaned: even if Android hangs on to a
+    // vestigial entry for a few seconds, we don't want Chrome to serve
+    // its old icon back to the launcher when RefreshCacheTick eventually
+    // syncs.  Delete eagerly.
+    DeleteIconForPackage(package_id);
+    // Same rationale as InstallApk: background refresh will re-enumerate
+    // and emit AppListChanged once the CLI succeeds.  A trailing empty
+    // result is legitimate ("the app the user just removed was the last
+    // one") and now correctly persisted because ListApps returns
+    // optional<vector>: a real success returns an empty vector, a CLI
+    // failure returns nullopt and simply reschedules another attempt.
+    ScheduleRefreshCache(base::Seconds(1));
+  }
+  return ok;
+}
+
+void DBusAdaptor::SaveIconForPackage(
+    const std::string& package_id,
+    const std::vector<uint8_t>& icon_png) const {
+  if (!IsSafePackageId(package_id) || icon_png.empty()) {
+    return;
+  }
+  base::File::Error create_err;
+  if (!base::CreateDirectoryAndGetError(base::FilePath(kIconDir),
+                                        &create_err)) {
+    LOG(WARNING) << "Cannot create " << kIconDir << ": " << create_err;
+    return;
+  }
+  const base::FilePath dst = IconPathForPackage(package_id);
+  if (!base::WriteFile(dst, icon_png)) {
+    LOG(WARNING) << "Failed to persist icon at " << dst.value();
+  }
+}
+
+std::vector<uint8_t> DBusAdaptor::LoadIconForPackage(
+    const std::string& package_id) const {
+  if (!IsSafePackageId(package_id)) {
+    return {};
+  }
+  const base::FilePath src = IconPathForPackage(package_id);
+  std::string data;
+  if (!base::ReadFileToString(src, &data)) {
+    return {};  // no icon yet is fine -- Chrome falls back to a default
+  }
+  return std::vector<uint8_t>(data.begin(), data.end());
+}
+
+void DBusAdaptor::DeleteIconForPackage(const std::string& package_id) const {
+  if (!IsSafePackageId(package_id)) {
+    return;
+  }
+  base::DeleteFile(IconPathForPackage(package_id));
+}
+
+bool DBusAdaptor::LaunchApp(const std::string& package_id) {
+  std::string ensure_err;
+  if (!cli_.EnsureRunning(&ensure_err)) {
+    LOG(ERROR) << "LaunchApp(" << package_id
+               << "): container start failed: " << ensure_err;
+    return false;
+  }
+  // Implicit foreground bump as a safety net; the caller (Chrome) is
+  // responsible for SetBackground when the window loses focus.  A
+  // missed bump just means the launch itself runs throttled, which is
+  // recoverable -- the user will SetForeground via Chrome's window
+  // focus path moments later.
+  cli_.SetCpuShares(WaydroidCli::kCpuSharesForeground);
+  return cli_.LaunchApp(package_id);
+}
+
+bool DBusAdaptor::SetForeground() {
+  return cli_.SetCpuShares(WaydroidCli::kCpuSharesForeground);
+}
+
+bool DBusAdaptor::SetBackground() {
+  return cli_.SetCpuShares(WaydroidCli::kCpuSharesBackground);
+}
+
+Daemon::Daemon() : DBusServiceDaemon(/*service_name=*/"id.waydro.Helper") {}
+
+void Daemon::RegisterDBusObjectsAsync(
+    brillo::dbus_utils::AsyncEventSequencer* sequencer) {
+  adaptor_ = std::make_unique<DBusAdaptor>(bus_);
+  adaptor_->RegisterAsync(
+      sequencer->GetHandler("DBusAdaptor.RegisterAsync() failed.", true));
+
+  // Cooperative suspend integration: register with powerd as a suspend
+  // delay client so we can put Android into Doze (releasing wake locks)
+  // before the cgroup freezer hits.  Non-fatal if powerd is unavailable
+  // -- the rest of the helper still functions.
+  suspend_coordinator_ = std::make_unique<SuspendCoordinator>(bus_);
+  suspend_coordinator_->Init();
+}
+
+}  // namespace waydroid_helper

--- /dev/null
+++ b/waydroid_helper/app_cache.cc
@@ -0,0 +1,76 @@
+// Copyright 2026 NAVER Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "waydroid_helper/app_cache.h"
+
+#include <utility>
+
+#include <base/files/file_path.h>
+#include <base/files/file_util.h>
+#include <base/logging.h>
+#include <base/strings/string_split.h>
+
+namespace waydroid_helper {
+
+AppCache::AppCache(const std::string& path) : path_(path) {}
+
+std::vector<WaydroidCli::App> AppCache::Load() const {
+  std::string contents;
+  if (!base::ReadFileToString(base::FilePath(path_), &contents)) {
+    // First run or container has never been brought up successfully --
+    // a missing file isn't an error, just "no cache yet".
+    return {};
+  }
+
+  std::vector<WaydroidCli::App> apps;
+  for (std::string_view line :
+       base::SplitStringPiece(contents, "\n", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    auto fields = base::SplitStringPiece(line, "\t", base::KEEP_WHITESPACE,
+                                         base::SPLIT_WANT_ALL);
+    if (fields.size() != 2) {
+      LOG(WARNING) << "AppCache: skipping malformed line in " << path_
+                   << " (expected 2 tab-separated fields, got "
+                   << fields.size() << ")";
+      continue;
+    }
+    WaydroidCli::App app;
+    app.name = std::string(fields[0]);
+    app.package_id = std::string(fields[1]);
+    // Icons live in a separate on-disk store (see app_cache.h header
+    // comment) and get overlaid at ListApps serving time; the TSV stays
+    // metadata-only so cache corruption can never affect launcher art.
+    apps.push_back(std::move(app));
+  }
+  return apps;
+}
+
+void AppCache::Save(const std::vector<WaydroidCli::App>& apps) const {
+  // Ensure the parent dir exists.  /var/lib/waydroid_helper is created
+  // by the ebuild's tmpfiles.d (or first-run mkdir below if running off
+  // a dev image without it).
+  base::FilePath file_path(path_);
+  base::FilePath parent = file_path.DirName();
+  if (!base::DirectoryExists(parent)) {
+    base::File::Error err = base::File::FILE_OK;
+    if (!base::CreateDirectoryAndGetError(parent, &err)) {
+      LOG(WARNING) << "AppCache: failed to mkdir " << parent.value()
+                   << " err=" << err;
+      return;
+    }
+  }
+
+  std::string out;
+  for (const auto& a : apps) {
+    out += a.name;
+    out += '\t';
+    out += a.package_id;
+    out += '\n';
+  }
+  if (!base::WriteFile(file_path, out)) {
+    LOG(WARNING) << "AppCache: failed to write " << path_;
+  }
+}
+
+}  // namespace waydroid_helper
diff --git a/waydroid_helper/app_cache.h b/waydroid_helper/app_cache.h
new file mode 100644
index 0000000000..4de2d0fd2b
--- /dev/null
+++ b/waydroid_helper/app_cache.h
@@ -0,0 +1,62 @@
+// Copyright 2026 NAVER Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef WAYDROID_HELPER_APP_CACHE_H_
+#define WAYDROID_HELPER_APP_CACHE_H_
+
+#include <string>
+#include <vector>
+
+#include "waydroid_helper/waydroid_cli.h"
+
+namespace waydroid_helper {
+
+// Persists the last successful ListApps() result so ListApps() can still
+// answer (with stale data) while the container is stopped under the
+// lazy-start model.  Chrome's WaydroidApps publisher populates the
+// launcher at login from this cache; the container itself only boots
+// when the user actually picks an app.
+//
+// File format is intentionally trivial -- one entry per app, '\t' between
+// fields, '\n' between apps.  Only (name, package_id) live in the TSV;
+// launcher icons are stored as separate PNG files at
+// /var/lib/waydroid_helper/icons/<package_id>.png (see
+// DBusAdaptor::SaveIconForPackage) and overlaid into ListApps replies at
+// serving time -- keeping the TSV parser trivial and letting icons be
+// replaced/deleted independently of the app list.
+//
+//   name<TAB>package_id<NEWLINE>
+//   name<TAB>package_id<NEWLINE>
+//   ...
+class AppCache {
+ public:
+  // Default path under /var/lib so the cache survives reboots but lives
+  // on the same encrypted stateful partition as the rest of waydroid's
+  // user data.
+  static constexpr char kDefaultPath[] =
+      "/var/lib/waydroid_helper/app_cache.tsv";
+
+  explicit AppCache(const std::string& path = kDefaultPath);
+  AppCache(const AppCache&) = delete;
+  AppCache& operator=(const AppCache&) = delete;
+  ~AppCache() = default;
+
+  // Reads cache from disk.  Returns an empty vector on first run / file
+  // missing / parse error -- never throws.  Logs a single warning on
+  // parse failure so we notice cache corruption without spamming.
+  std::vector<WaydroidCli::App> Load() const;
+
+  // Writes |apps| to disk, replacing any prior content.  Best-effort: a
+  // failure here only means the next ListApps call before the container
+  // is up again will return an empty list, so we log but don't fail the
+  // outer ListApps RPC.
+  void Save(const std::vector<WaydroidCli::App>& apps) const;
+
+ private:
+  std::string path_;
+};
+
+}  // namespace waydroid_helper
+
+#endif  // WAYDROID_HELPER_APP_CACHE_H_

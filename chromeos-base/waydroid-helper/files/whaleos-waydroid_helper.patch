+#ifndef WAYDROID_HELPER_WAYDROID_CLI_H_
+#define WAYDROID_HELPER_WAYDROID_CLI_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include <base/time/time.h>
+
+namespace waydroid_helper {
+
+// Thin synchronous wrapper around the `waydroid app {list,install,remove,
+// launch}` CLI.  All methods block until the child process exits; callers
+// run them on the D-Bus thread but the operations themselves are fast
+// (typically <1s except for InstallApk which can take several seconds for
+// large APKs).
+class WaydroidCli {
+ public:
+  struct App {
+    std::string name;
+    std::string package_id;
+    // Always empty on this path: `waydroid app list` doesn't emit icon
+    // data.  Launcher icons come from a different pipeline -- the daemon
+    // parses the APK at InstallApk time (apk_metadata.cc) and stores the
+    // PNG at /var/lib/waydroid_helper/icons/<package_id>.png, which
+    // DBusAdaptor::ListApps overlays into the reply before it goes out
+    // to Chrome.  Kept as a struct field for wire-format compatibility.
+    std::vector<uint8_t> icon_png;
+  };
+
+  WaydroidCli() = default;
+  WaydroidCli(const WaydroidCli&) = delete;
+  WaydroidCli& operator=(const WaydroidCli&) = delete;
+  ~WaydroidCli() = default;
+
+  // Parses `waydroid app list` and returns user-installed apps only (the
+  // LineageOS system apps in kSystemAppBlocklist are filtered out).  Returns
+  // nullopt when the CLI failed (timeout, non-zero exit, container not
+  // running) -- callers must not treat that as "no apps installed", because
+  // right after login the Android side often needs several seconds to bring
+  // its waydroidplatform binder service up.  An empty vector means the CLI
+  // ran to completion and there really are no user apps.
+  std::optional<std::vector<App>> ListApps();
+
+  // Returns true on a clean exit code from `waydroid app install`.  On
+  // failure, |error_out| is populated with the CLI's stderr (truncated).
+  bool InstallApk(const std::string& apk_path, std::string* error_out);
+
+  // Returns true on clean exit from `waydroid app remove <package_id>`.
+  bool RemoveApp(const std::string& package_id);
+
+  // Returns true on clean exit from `waydroid app launch <package_id>`.
+  bool LaunchApp(const std::string& package_id);
+
+  // Returns true if the Waydroid LXC container is currently running.
+  // Fast (no boot wait); calls `waydroid status` and parses the output.
+  bool IsRunning();
+
+  // Returns true iff Android inside the container has finished booting,
+  // i.e. `getprop sys.boot_completed` reads "1".  Returns false if the
+  // container is down or `lxc-attach` fails for any reason.  Used by
+  // the daemon's background boot watcher to detect when it can drop
+  // cpu.shares to background without breaking cold-start time.
+  bool IsBootCompleted();
+
+  // Synchronously brings the container up.  If already running, returns
+  // true immediately.  Otherwise:
+  //   1. Triggers the waydroid-container upstart job (no-op if already
+  //      started).
+  //   2. Polls sys.boot_completed inside the container until "1" or
+  //      timeout (~30s).
+  // Returns false on failure; |error_out| gets a human-readable reason.
+  bool EnsureRunning(std::string* error_out);
+
+  // CPU share class for the LXC payload cgroup.  Phase C mirrors
+  // ARC++'s SetArcCpuRestriction(): 1024 = same priority as ChromeOS
+  // Chrome processes, 64 = background (~16x lower).  Returns false if
+  // the cgroup is not present (container not running yet).
+  static constexpr int kCpuSharesForeground = 1024;
+  static constexpr int kCpuSharesBackground = 64;
+  bool SetCpuShares(int shares);
+
+  // Cooperative suspend: ask Android to release non-critical wake locks
+  // before powerd freezes the container cgroup.  EnterDoze runs
+  // `cmd deviceidle force-idle deep` inside the container which puts
+  // Android into the deepest doze level (network off, alarms deferred,
+  // wake locks released).  ExitDoze undoes it on resume.
+  //
+  // Both return after the underlying `waydroid shell` invocation
+  // completes; typical latency is 1-3 seconds.  Best-effort: return
+  // value indicates only whether the subprocess exited cleanly --
+  // failures are non-fatal and merely mean Android did not get a
+  // chance to clean up before suspend (powerd's wakeup-source check
+  // will still serialize correctly).
+  bool EnterDoze();
+  bool ExitDoze();
+
+ private:
+  // Path to the waydroid binary; overridable in tests.
+  std::string waydroid_path_ = "/usr/bin/waydroid";
+
+  // Runs |args| under the waydroid binary, captures stdout/stderr, and
+  // returns the child's exit status.  Returns -1 on spawn failure.
+  //
+  // |timeout_seconds| is forwarded to /usr/bin/timeout so a wedged
+  // `waydroid` subprocess can't hang the helper's D-Bus method handler.
+  // Use kFastWaydroidTimeoutSeconds for read-mostly calls (status,
+  // app list, app launch -- these only marshal a Binder RPC).  Use
+  // kInstallWaydroidTimeoutSeconds for `app install`, where the
+  // container performs dexopt on the new APK and routinely takes
+  // tens of seconds (several minutes on the largest first-launch
+  // installs of a Play Store APK).
+  static constexpr int kFastWaydroidTimeoutSeconds = 5;
+  static constexpr int kInstallWaydroidTimeoutSeconds = 300;
+  int RunWaydroid(const std::vector<std::string>& args,
+                  std::string* stdout_out,
+                  std::string* stderr_out,
+                  int timeout_seconds);
+
+  // Runs `timeout N lxc-attach -- getprop sys.boot_completed`. Returns
+  // true iff the container reports "1". |timeout| is the per-probe
+  // budget passed to timeout(1); the reason IsBootCompleted() and
+  // EnsureRunning() share this helper is so the polling path can shrink
+  // each probe to fit within its absolute deadline instead of running
+  // raw lxc-attach that can block indefinitely on a wedged container.
+  bool ProbeBootCompleted(base::TimeDelta timeout);
+};
+
+}  // namespace waydroid_helper
+
+#endif  // WAYDROID_HELPER_WAYDROID_CLI_H_

+}
diff --git a/waydroid_helper/suspend_coordinator.cc b/waydroid_helper/suspend_coordinator.cc
new file mode 100644
index 0000000000..1b7472d77d
--- /dev/null
+++ b/waydroid_helper/suspend_coordinator.cc
@@ -0,0 +1,165 @@
+// Copyright 2026 NAVER Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "waydroid_helper/suspend_coordinator.h"
+
+#include <memory>
+#include <utility>
+
+#include <base/functional/bind.h>
+#include <base/logging.h>
+#include <base/time/time.h>
+#include <chromeos/dbus/service_constants.h>
+#include <dbus/message.h>
+#include <dbus/object_path.h>
+#include <power_manager/proto_bindings/suspend.pb.h>
+
+namespace waydroid_helper {
+
+namespace {
+
+constexpr char kDelayDescription[] = "waydroid_helper";
+
+// 7 seconds matches the precedent in platform2/trunks/power_manager.cc.
+// Doze enter/exit `waydroid shell` invocations are typically 1-3s, so
+// 7s leaves comfortable headroom for slow Android-side dumpsys calls.
+constexpr base::TimeDelta kSuspendTimeout = base::Seconds(7);
+
+}  // namespace
+
+SuspendCoordinator::SuspendCoordinator(scoped_refptr<dbus::Bus> bus)
+    : bus_(std::move(bus)) {}
+
+void SuspendCoordinator::Init() {
+  powerd_proxy_ = bus_->GetObjectProxy(
+      power_manager::kPowerManagerServiceName,
+      dbus::ObjectPath(power_manager::kPowerManagerServicePath));
+  if (!powerd_proxy_) {
+    LOG(ERROR) << "Failed to acquire powerd object proxy; cooperative "
+                  "suspend disabled";
+    return;
+  }
+  // If powerd restarts, re-register so we don't miss the next suspend.
+  powerd_proxy_->SetNameOwnerChangedCallback(base::BindRepeating(
+      &SuspendCoordinator::OnPowerdNameOwnerChanged,
+      weak_ptr_factory_.GetWeakPtr()));
+  RegisterSuspendDelay();
+}
+
+void SuspendCoordinator::OnPowerdNameOwnerChanged(
+    const std::string& /*old_owner*/, const std::string& new_owner) {
+  if (new_owner.empty()) {
+    // powerd went away; our delay_id is no longer valid.
+    delay_id_ = std::nullopt;
+    return;
+  }
+  RegisterSuspendDelay();
+}
+
+void SuspendCoordinator::RegisterSuspendDelay() {
+  power_manager::RegisterSuspendDelayRequest request;
+  request.set_timeout(kSuspendTimeout.InMicroseconds());
+  request.set_description(kDelayDescription);
+  request.set_applicable_during_key_eviction(false);
+
+  dbus::MethodCall call(power_manager::kPowerManagerInterface,
+                        power_manager::kRegisterSuspendDelayMethod);
+  dbus::MessageWriter writer(&call);
+  writer.AppendProtoAsArrayOfBytes(request);
+
+  base::expected<std::unique_ptr<dbus::Response>, dbus::Error> resp(
+      powerd_proxy_->CallMethodAndBlock(
+          &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT));
+  if (!resp.has_value() || !resp.value()) {
+    LOG(ERROR) << "RegisterSuspendDelay call failed";
+    return;
+  }
+
+  power_manager::RegisterSuspendDelayReply reply;
+  dbus::MessageReader reader(resp.value().get());
+  if (!reader.PopArrayOfBytesAsProto(&reply)) {
+    LOG(ERROR) << "RegisterSuspendDelay reply was not a parsable proto";
+    return;
+  }
+  delay_id_ = reply.delay_id();
+  LOG(INFO) << "Registered suspend delay id=" << *delay_id_;
+
+  // Subscribe to both signals.  ConnectToSignal is idempotent across
+  // re-registers (powerd restart) because we don't disconnect first --
+  // duplicate callbacks would only call back twice, both Doze handlers
+  // are idempotent.
+  powerd_proxy_->ConnectToSignal(
+      power_manager::kPowerManagerInterface,
+      power_manager::kSuspendImminentSignal,
+      base::BindRepeating(&SuspendCoordinator::HandleSuspendImminent,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&SuspendCoordinator::OnSignalConnected,
+                     weak_ptr_factory_.GetWeakPtr()));
+  powerd_proxy_->ConnectToSignal(
+      power_manager::kPowerManagerInterface,
+      power_manager::kSuspendDoneSignal,
+      base::BindRepeating(&SuspendCoordinator::HandleSuspendDone,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&SuspendCoordinator::OnSignalConnected,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void SuspendCoordinator::OnSignalConnected(const std::string& interface,
+                                           const std::string& signal,
+                                           bool success) {
+  if (!success) {
+    LOG(ERROR) << "Failed to subscribe to " << interface << "." << signal;
+  }
+}
+
+void SuspendCoordinator::HandleSuspendImminent(dbus::Signal* signal) {
+  power_manager::SuspendImminent info;
+  dbus::MessageReader reader(signal);
+  if (!reader.PopArrayOfBytesAsProto(&info)) {
+    LOG(WARNING) << "SuspendImminent: unparsable proto, acking anyway";
+    return;
+  }
+  int suspend_id = info.suspend_id();
+  LOG(INFO) << "SuspendImminent id=" << suspend_id
+            << " -- entering Android Doze";
+
+  // Synchronous; blocks the daemon's D-Bus thread for 1-3s.  Acceptable
+  // because powerd is itself waiting for our ack and nothing else hits
+  // our interface during suspend prep.  If EnterDoze fails the suspend
+  // still proceeds -- powerd will then either succeed (if no wake
+  // sources are stuck) or harmlessly abort and retry.
+  cli_.EnterDoze();
+  SendSuspendReady(suspend_id);
+}
+
+void SuspendCoordinator::HandleSuspendDone(dbus::Signal* signal) {
+  power_manager::SuspendDone info;
+  dbus::MessageReader reader(signal);
+  if (reader.PopArrayOfBytesAsProto(&info)) {
+    LOG(INFO) << "SuspendDone id=" << info.suspend_id() << " duration_us="
+              << info.suspend_duration() << " -- exiting Android Doze";
+  } else {
+    LOG(INFO) << "SuspendDone (unparsable proto) -- exiting Android Doze";
+  }
+  cli_.ExitDoze();
+}
+
+void SuspendCoordinator::SendSuspendReady(int suspend_id) {
+  if (!delay_id_) {
+    LOG(WARNING) << "SendSuspendReady: no delay_id, skipping ack";
+    return;
+  }
+  power_manager::SuspendReadinessInfo info;
+  info.set_delay_id(*delay_id_);
+  info.set_suspend_id(suspend_id);
+
+  dbus::MethodCall call(power_manager::kPowerManagerInterface,
+                        power_manager::kHandleSuspendReadinessMethod);
+  dbus::MessageWriter writer(&call);
+  writer.AppendProtoAsArrayOfBytes(info);
+  (void)powerd_proxy_->CallMethodAndBlock(
+      &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT);
+}
+
+}  // namespace waydroid_helper
diff --git a/waydroid_helper/suspend_coordinator.h b/waydroid_helper/suspend_coordinator.h
new file mode 100644
index 0000000000..b118d5944f
--- /dev/null
+++ b/waydroid_helper/suspend_coordinator.h
@@ -0,0 +1,81 @@
+// Copyright 2026 NAVER Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef WAYDROID_HELPER_SUSPEND_COORDINATOR_H_
+#define WAYDROID_HELPER_SUSPEND_COORDINATOR_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include <base/memory/scoped_refptr.h>
+#include <base/memory/weak_ptr.h>
+#include <dbus/bus.h>
+#include <dbus/object_proxy.h>
+
+#include "waydroid_helper/waydroid_cli.h"
+
+namespace waydroid_helper {
+
+// Cooperative suspend handler.  Registers waydroid_helper as a powerd
+// suspend-delay client; on each SuspendImminent we put the Waydroid
+// Android container into deep Doze (which releases its non-critical
+// kernel wake sources) before acknowledging powerd.  Without this,
+// EPOLLWAKEUP wake sources held by Android system_server's epoll fds
+// would stay active across the cgroup freeze and wedge powerd in
+// pm_get_wakeup_count().  See patch 0014 header for the full chain.
+//
+// On SuspendDone (resume), we tell Android to leave Doze so apps can
+// run again.
+//
+// All work happens on the daemon's main D-Bus thread; both Doze enter
+// and exit are synchronous `waydroid shell` invocations that typically
+// take 1-3 seconds.  The 7-second suspend-delay timeout (matches
+// trunks/power_manager.cc precedent) leaves headroom for slow shells.
+class SuspendCoordinator {
+ public:
+  explicit SuspendCoordinator(scoped_refptr<dbus::Bus> bus);
+  SuspendCoordinator(const SuspendCoordinator&) = delete;
+  SuspendCoordinator& operator=(const SuspendCoordinator&) = delete;
+  ~SuspendCoordinator() = default;
+
+  // Connects to powerd, registers the suspend delay, and subscribes to
+  // SuspendImminent / SuspendDone.  Logs on failure but never throws.
+  void Init();
+
+ private:
+  // Re-register on powerd restart.
+  void OnPowerdNameOwnerChanged(const std::string& old_owner,
+                                const std::string& new_owner);
+
+  void RegisterSuspendDelay();
+  void OnSignalConnected(const std::string& interface,
+                         const std::string& signal,
+                         bool success);
+
+  void HandleSuspendImminent(dbus::Signal* signal);
+  void HandleSuspendDone(dbus::Signal* signal);
+
+  // Acks powerd that we're ready for |suspend_id| to proceed.
+  void SendSuspendReady(int suspend_id);
+
+  scoped_refptr<dbus::Bus> bus_;
+  dbus::ObjectProxy* powerd_proxy_ = nullptr;  // not owned
+
+  // Stateless wrapper around `waydroid shell -- ...`; owning a separate
+  // instance avoids tangling our lifetime with the DBusAdaptor's cli_
+  // (no shared state -- each call is its own subprocess).
+  WaydroidCli cli_;
+
+  // delay_id_ is populated after a successful RegisterSuspendDelay
+  // and consumed by SendSuspendReady.  std::nullopt means we're not
+  // currently registered (e.g. powerd hasn't come up yet).
+  std::optional<int> delay_id_;
+
+  base::WeakPtrFactory<SuspendCoordinator> weak_ptr_factory_{this};
+};
+
+}  // namespace waydroid_helper
+
+#endif  // WAYDROID_HELPER_SUSPEND_COORDINATOR_H_
diff --git a/waydroid_helper/system_apps_blocklist.h b/waydroid_helper/system_apps_blocklist.h
new file mode 100644
index 0000000000..09a0374ac1
--- /dev/null
+++ b/waydroid_helper/system_apps_blocklist.h
@@ -0,0 +1,56 @@
+// Copyright 2026 NAVER Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef WAYDROID_HELPER_SYSTEM_APPS_BLOCKLIST_H_
+#define WAYDROID_HELPER_SYSTEM_APPS_BLOCKLIST_H_
+
+#include <string_view>
+
+namespace waydroid_helper {
+
+// LineageOS apps pre-installed inside the Waydroid system.img.  ListApps
+// excludes these so the ChromeOS launcher only surfaces user-installed apps
+// (apps the user adds via the Files-app .apk handler).  Update this list if
+// the bundled Waydroid image's app set changes (e.g. on Android version
+// bump or vendor.img refresh).
+inline constexpr std::string_view kSystemAppBlocklist[] = {
+    // LineageOS user-facing apps that ship pre-installed in system.img
+    // and would otherwise show up in the ChromeOS launcher next to
+    // user-installed apps.  These have proper LAUNCHER intent filters
+    // and so would survive the LAUNCHER-only filter; we explicitly
+    // exclude them so the launcher only surfaces apps the user added.
+    "com.android.documentsui",          // Files
+    "com.android.contacts",             // Contacts
+    "org.lineageos.recorder",           // Recorder
+    "com.android.gallery3d",            // Gallery
+    "org.lineageos.jelly",              // Browser
+    "org.lineageos.eleven",             // Music
+    "org.lineageos.etar",               // Calendar
+    "org.lineageos.aperture",           // Camera
+    "com.android.settings",             // Settings
+    "com.android.calculator2",          // Calculator
+    "com.android.deskclock",            // Clock
+
+    // System utilities / providers that don't normally have a LAUNCHER
+    // intent but have shown up in the ChromeOS launcher in past sessions
+    // (likely via stale AppListSyncableService entries from a previous
+    // build).  Belt-and-braces: hard-exclude here so they can never end
+    // up in a published list regardless of how `waydroid app list`
+    // chooses to enumerate them in future LineageOS revisions.
+    "com.android.inputmethod.latin",    // Android Keyboard (AOSP) IME
+    "com.android.webview",              // WebView system component
+    "com.android.provision",            // Provisioning app
+    "com.android.printspooler",         // Print spooler
+    "org.protonaosp.deviceconfig",      // Proton AOSP device config
+    "org.lineageos.lineageparts",       // LineageOS settings extension
+    "org.lineageos.profiles",           // LineageOS profiles
+    "org.lineageos.waydroidupdater",    // Waydroid in-container updater
+    "com.stevesoltys.seedvault",        // System backup helper
+    "org.calyxos.backup.contacts",      // System contacts backup helper
+    "com.google.android.apps.googlecamera.fishfood",  // Bundled GCam
+};
+
+}  // namespace waydroid_helper
+
+#endif  // WAYDROID_HELPER_SYSTEM_APPS_BLOCKLIST_H_
diff --git a/waydroid_helper/waydroid_cli.cc b/waydroid_helper/waydroid_cli.cc
new file mode 100644
index 0000000000..d702e70d6e
--- /dev/null
+++ b/waydroid_helper/waydroid_cli.cc
@@ -0,0 +1,397 @@
+// Copyright 2026 NAVER Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "waydroid_helper/waydroid_cli.h"
+
+#include <algorithm>
+#include <string_view>
+
+#include <base/files/file_path.h>
+#include <base/files/file_util.h>
+#include <base/logging.h>
+#include <base/strings/string_number_conversions.h>
+#include <base/strings/string_split.h>
+#include <base/strings/string_util.h>
+#include <base/threading/platform_thread.h>
+#include <base/time/time.h>
+#include <brillo/process/process.h>
+
+#include "waydroid_helper/system_apps_blocklist.h"
+
+namespace waydroid_helper {
+
+namespace {
+
+// `waydroid app list` emits records like:
+//
+//   Name: Files
+//   packageName: com.android.documentsui
+//   categories:
+//       android.intent.category.LAUNCHER
+//   Name: Contacts
+//   packageName: ...
+//
+// Records are not separated by blank lines, so we treat "Name:" as the
+// start of a new record and accumulate fields until the next "Name:".
+constexpr char kFieldName[] = "Name:";
+constexpr char kFieldPackage[] = "packageName:";
+
+// Conservative cap on stderr captured into D-Bus error replies.
+constexpr size_t kMaxStderrBytes = 512;
+
+bool IsBlocklisted(std::string_view package_id) {
+  for (std::string_view blocked : kSystemAppBlocklist) {
+    if (package_id == blocked) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void Trim(std::string* s) {
+  base::TrimWhitespaceASCII(*s, base::TRIM_ALL, s);
+}
+
+}  // namespace
+
+int WaydroidCli::RunWaydroid(const std::vector<std::string>& args,
+                             std::string* stdout_out,
+                             std::string* stderr_out,
+                             int timeout_seconds) {
+  // Wrap every `waydroid ...` invocation in coreutils `timeout(1)`.
+  // `waydroid app list / install / ...` all go via the IPlatform binder
+  // service inside the container; if that service is missing or wedged
+  // (typical right after a sign-in cold start while Android is still
+  // booting), the Python CLI retries forever rather than failing fast.
+  // Without a cap, our D-Bus method handlers would hang for the full
+  // 25s default reply timeout and the caller (Chrome's WaydroidApps
+  // publisher) would surface an empty list to the launcher.
+  //
+  // Callers pick the cap that fits the command (see
+  // kFastWaydroidTimeoutSeconds / kInstallWaydroidTimeoutSeconds): a
+  // few seconds is enough for read-only queries against a healthy
+  // container, while `app install` runs dexopt on the new APK inside
+  // the container and routinely needs minutes.
+  brillo::ProcessImpl process;
+  process.AddArg("/usr/bin/timeout");
+  process.AddArg("--kill-after=1");
+  process.AddArg(base::NumberToString(timeout_seconds));
+  process.AddArg(waydroid_path_);
+  for (const std::string& a : args) {
+    process.AddArg(a);
+  }
+  process.RedirectUsingMemory(STDOUT_FILENO);
+  process.RedirectUsingMemory(STDERR_FILENO);
+
+  int exit_code = process.Run();
+  if (stdout_out) {
+    *stdout_out = process.GetOutputString(STDOUT_FILENO);
+  }
+  if (stderr_out) {
+    *stderr_out = process.GetOutputString(STDERR_FILENO);
+    if (stderr_out->size() > kMaxStderrBytes) {
+      stderr_out->resize(kMaxStderrBytes);
+    }
+  }
+  // timeout(1) exit codes: 124=timeout (SIGTERM), 137=128+9 after kill,
+  // 125=timeout itself failed, 126/127=command not runnable.  Callers
+  // check for non-zero; we just preserve whatever timeout returned.
+  return exit_code;
+}
+
+std::optional<std::vector<WaydroidCli::App>> WaydroidCli::ListApps() {
+  std::string stdout_str;
+  std::string stderr_str;
+  int rc = RunWaydroid({"app", "list"}, &stdout_str, &stderr_str,
+                       kFastWaydroidTimeoutSeconds);
+  if (rc != 0) {
+    LOG(WARNING) << "waydroid app list exit=" << rc << " stderr=" << stderr_str;
+    return std::nullopt;
+  }
+
+  std::vector<App> apps;
+  App current;
+  bool current_has_name = false;
+  bool current_has_pkg = false;
+
+  for (std::string_view line :
+       base::SplitStringPiece(stdout_str, "\n", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (base::StartsWith(line, kFieldName)) {
+      // Flush any prior record before starting a new one.
+      if (current_has_name && current_has_pkg &&
+          !IsBlocklisted(current.package_id)) {
+        apps.push_back(std::move(current));
+      }
+      current = App{};
+      current_has_name = false;
+      current_has_pkg = false;
+
+      current.name = std::string(line.substr(sizeof(kFieldName) - 1));
+      Trim(&current.name);
+      current_has_name = true;
+    } else if (base::StartsWith(line, kFieldPackage)) {
+      current.package_id = std::string(line.substr(sizeof(kFieldPackage) - 1));
+      Trim(&current.package_id);
+      current_has_pkg = true;
+    }
+    // "categories:" and indented category lines are ignored -- Chrome's
+    // launcher doesn't consume Android's intent categories, and we'd end
+    // up burning parse cycles on them for nothing.
+  }
+  // Don't forget the last record.
+  if (current_has_name && current_has_pkg &&
+      !IsBlocklisted(current.package_id)) {
+    apps.push_back(std::move(current));
+  }
+
+  return apps;
+}
+
+bool WaydroidCli::InstallApk(const std::string& apk_path,
+                             std::string* error_out) {
+  std::string stderr_str;
+  int rc = RunWaydroid({"app", "install", apk_path}, /*stdout=*/nullptr,
+                       &stderr_str, kInstallWaydroidTimeoutSeconds);
+  if (rc != 0 && error_out) {
+    *error_out = stderr_str.empty() ? "waydroid app install failed"
+                                    : std::move(stderr_str);
+  }
+  return rc == 0;
+}
+
+bool WaydroidCli::RemoveApp(const std::string& package_id) {
+  std::string stderr_str;
+  int rc = RunWaydroid({"app", "remove", package_id}, /*stdout=*/nullptr,
+                       &stderr_str, kFastWaydroidTimeoutSeconds);
+  if (rc != 0) {
+    LOG(WARNING) << "waydroid app remove " << package_id << " exit=" << rc
+                 << " stderr=" << stderr_str;
+  }
+  return rc == 0;
+}
+
+bool WaydroidCli::LaunchApp(const std::string& package_id) {
+  std::string stderr_str;
+  int rc = RunWaydroid({"app", "launch", package_id}, /*stdout=*/nullptr,
+                       &stderr_str, kFastWaydroidTimeoutSeconds);
+  if (rc != 0) {
+    LOG(WARNING) << "waydroid app launch " << package_id << " exit=" << rc
+                 << " stderr=" << stderr_str;
+  }
+  return rc == 0;
+}
+
+bool WaydroidCli::IsRunning() {
+  // `waydroid status` prints "Session: RUNNING" / "Session: STOPPED".
+  // We accept a clean exit AND the running marker.
+  std::string out;
+  int rc = RunWaydroid({"status"}, &out, /*stderr=*/nullptr,
+                       kFastWaydroidTimeoutSeconds);
+  if (rc != 0) {
+    return false;
+  }
+  return out.find("RUNNING") != std::string::npos;
+}
+
+bool WaydroidCli::ProbeBootCompleted(base::TimeDelta timeout) {
+  // timeout(1) needs an integer number of seconds; guarantee >=1s so we
+  // don't accidentally pass "0" (which would SIGTERM before lxc-attach
+  // even finishes execve).
+  const int64_t secs = std::max<int64_t>(1, timeout.InSeconds());
+  brillo::ProcessImpl getprop;
+  getprop.AddArg("/usr/bin/timeout");
+  getprop.AddArg("--kill-after=1");
+  getprop.AddArg(base::NumberToString(secs));
+  getprop.AddArg("/usr/bin/lxc-attach");
+  getprop.AddArg("-n");
+  getprop.AddArg("waydroid");
+  getprop.AddArg("-P");
+  getprop.AddArg("/usr/local/var/lib/waydroid/lxc");
+  getprop.AddArg("--");
+  getprop.AddArg("getprop");
+  getprop.AddArg("sys.boot_completed");
+  getprop.RedirectUsingMemory(STDOUT_FILENO);
+  if (getprop.Run() != 0) {
+    return false;
+  }
+  std::string val = getprop.GetOutputString(STDOUT_FILENO);
+  base::TrimWhitespaceASCII(val, base::TRIM_ALL, &val);
+  return val == "1";
+}
+
+bool WaydroidCli::IsBootCompleted() {
+  return ProbeBootCompleted(base::Seconds(3));
+}
+
+bool WaydroidCli::EnsureRunning(std::string* error_out) {
+  // The contract of EnsureRunning is "Android inside the container is
+  // ready to take requests", so we must check sys.boot_completed -- not
+  // just the LXC session state.  Returning early on IsRunning() alone
+  // would let LaunchApp/InstallApk/RemoveApp run while zygote is still
+  // initializing, where every `waydroid app ...` invocation hits its 5s
+  // timeout because waydroidplatform isn't on binder yet.
+  if (IsRunning() && IsBootCompleted()) {
+    return true;
+  }
+
+  // Container isn't even up yet -- kick the upstart job.  `initctl
+  // start` returns once the job's exec is spawned (not when Android
+  // is up), and we still need to wait for boot_completed below.
+  // Skip the initctl step if LXC is already running but Android is
+  // still booting.
+  if (!IsRunning()) {
+    brillo::ProcessImpl proc;
+    proc.AddArg("/sbin/initctl");
+    proc.AddArg("start");
+    proc.AddArg("waydroid-container");
+    proc.RedirectUsingMemory(STDERR_FILENO);
+    int rc = proc.Run();
+    if (rc != 0) {
+      // Already running shows up as exit 1 with "Job is already running"
+      // -- not a real failure, fall through to the boot_completed poll.
+      std::string err = proc.GetOutputString(STDERR_FILENO);
+      if (err.find("already running") == std::string::npos) {
+        if (error_out) {
+          *error_out = "initctl start waydroid-container: " + err;
+        }
+        return false;
+      }
+    }
+  }
+
+  // Poll sys.boot_completed with an absolute 30s deadline. Each probe
+  // reuses ProbeBootCompleted's timeout(1) wrapper so a wedged
+  // lxc-attach can't monopolize the D-Bus main thread (which would
+  // block other helper requests and powerd's SuspendImminent handshake).
+  // Per-probe timeout is capped to fit the remaining budget so the sum
+  // of probe timeouts never exceeds the poll budget.
+  constexpr base::TimeDelta kBootCompletePollBudget = base::Seconds(30);
+  constexpr base::TimeDelta kMaxProbeTimeout = base::Seconds(3);
+  constexpr base::TimeDelta kPollInterval = base::Milliseconds(500);
+  const base::TimeTicks deadline =
+      base::TimeTicks::Now() + kBootCompletePollBudget;
+  while (true) {
+    const base::TimeDelta remaining = deadline - base::TimeTicks::Now();
+    if (remaining < base::Seconds(1)) {
+      break;
+    }
+    if (ProbeBootCompleted(std::min(kMaxProbeTimeout, remaining))) {
+      return true;
+    }
+    const base::TimeDelta after = deadline - base::TimeTicks::Now();
+    if (after <= base::TimeDelta()) {
+      break;
+    }
+    base::PlatformThread::Sleep(std::min(kPollInterval, after));
+  }
+
+  if (error_out) {
+    *error_out =
+        "Timed out waiting for sys.boot_completed (container started but "
+        "Android did not finish booting within 30s)";
+  }
+  return false;
+}
+
+namespace {
+
+// Runs `waydroid shell -- <cmd...>` under coreutils `timeout(1)`.
+// Returns the child's exit status, -1 on spawn failure.  Output is
+// discarded; callers log on failure.
+//
+// timeout(1) wraps the whole pipeline (waydroid -> waydroid shell ->
+// lxc-attach -> Android side) and sends SIGTERM after |timeout|, then
+// SIGKILL after a further --kill-after grace.  Using it instead of
+// hand-rolled waitpid polling keeps the helper out of brillo::Process's
+// reap path (which has subtle interactions with SIGCHLD handlers in
+// libchrome's message loop) and gives us a single shell command that
+// is easy to reason about.
+//
+// We need this safety net because EnterDoze / ExitDoze run on the
+// daemon's D-Bus thread inside a SuspendImminent handler: if the
+// underlying `waydroid shell` blocks (binder backed up, session
+// daemon stuck, container half-frozen, etc.) we must still ack within
+// powerd's 7-second suspend delay or the whole suspend cycle fails.
+//
+// timeout(1) exit codes (per GNU coreutils):
+//   124 - command timed out (SIGTERM sent)
+//   125 - timeout itself failed
+//   126 - command found but not executable
+//   127 - command not found
+//   128+N - command killed by signal N (e.g. 137 = 128+9 after SIGKILL)
+int RunWaydroidShell(const std::string& waydroid_path,
+                     const std::vector<std::string>& cmd,
+                     base::TimeDelta timeout) {
+  brillo::ProcessImpl proc;
+  proc.AddArg("/usr/bin/timeout");
+  proc.AddArg("--kill-after=1");
+  proc.AddArg(base::NumberToString(timeout.InSeconds()));
+  proc.AddArg(waydroid_path);
+  proc.AddArg("shell");
+  proc.AddArg("--");
+  for (const std::string& a : cmd) {
+    proc.AddArg(a);
+  }
+  proc.RedirectUsingMemory(STDERR_FILENO);
+  const int rc = proc.Run();
+  if (rc == 124 || rc == 137) {
+    LOG(WARNING) << "waydroid shell -- " << cmd[0]
+                 << " ... timed out after " << timeout.InSecondsF()
+                 << "s (rc=" << rc << ")";
+    return rc;
+  }
+  if (rc != 0) {
+    LOG(WARNING) << "waydroid shell -- " << cmd[0] << " ... exit=" << rc
+                 << " stderr=" << proc.GetOutputString(STDERR_FILENO);
+  }
+  return rc;
+}
+
+}  // namespace
+
+bool WaydroidCli::EnterDoze() {
+  // `cmd deviceidle force-idle deep` works on Android 8+, including
+  // LineageOS 20 (Android 13).  It forces immediate transition to the
+  // deepest Doze state, which is the part of Android's normal sleep
+  // path that releases non-critical wake locks.
+  //
+  // 6s cap leaves ~1s headroom inside powerd's 7s suspend delay
+  // (kSuspendTimeout in suspend_coordinator.cc) so the helper always
+  // gets to ack even if `waydroid shell` is stuck.
+  return RunWaydroidShell(waydroid_path_,
+                          {"cmd", "deviceidle", "force-idle", "deep"},
+                          base::Seconds(6)) == 0;
+}
+
+bool WaydroidCli::ExitDoze() {
+  // `cmd deviceidle unforce` un-pins the device from forced Doze and
+  // returns it to normal scheduling.  Required after resume so apps
+  // can run again.  ExitDoze runs after SuspendDone (no powerd delay
+  // budget to respect), but keep a finite cap so a stuck container
+  // doesn't park the D-Bus thread indefinitely.
+  return RunWaydroidShell(waydroid_path_,
+                          {"cmd", "deviceidle", "unforce"},
+                          base::Seconds(10)) == 0;
+}
+
+bool WaydroidCli::SetCpuShares(int shares) {
+  // cgroup v1 path -- matches what LXC creates for our payload.
+  static const base::FilePath kCpuSharesPath(
+      "/sys/fs/cgroup/cpu/lxc.payload.waydroid/cpu.shares");
+  if (!base::PathExists(kCpuSharesPath)) {
+    // Container not running, or post-start hook hasn't created it yet.
+    // Caller can retry.
+    return false;
+  }
+  std::string val = base::NumberToString(shares);
+  if (!base::WriteFile(kCpuSharesPath, val)) {
+    LOG(WARNING) << "SetCpuShares: failed to write " << val << " to "
+                 << kCpuSharesPath.value();
+    return false;
+  }
+  return true;
+}
+
+}  // namespace waydroid_helper

+
+#ifndef WAYDROID_HELPER_DAEMON_H_
+#define WAYDROID_HELPER_DAEMON_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <tuple>
+#include <vector>
+
+#include <base/memory/weak_ptr.h>
+#include <base/timer/timer.h>
+#include <brillo/daemons/dbus_daemon.h>
+
+#include "waydroid_helper/apk_metadata.h"
+#include "waydroid_helper/app_cache.h"
+#include "waydroid_helper/dbus_adaptors/id.waydro.Helper.h"
+#include "waydroid_helper/suspend_coordinator.h"
+#include "waydroid_helper/waydroid_cli.h"
+
+namespace waydroid_helper {
+
+class DBusAdaptor : public id::waydro::HelperInterface,
+                   public id::waydro::HelperAdaptor {
+ public:
+  explicit DBusAdaptor(scoped_refptr<dbus::Bus> bus);
+  DBusAdaptor(const DBusAdaptor&) = delete;
+  DBusAdaptor& operator=(const DBusAdaptor&) = delete;
+  ~DBusAdaptor() override = default;
+
+  void RegisterAsync(
+      brillo::dbus_utils::AsyncEventSequencer::CompletionAction cb);
+
+  // id::waydro::HelperInterface overrides.  Methods with two or more
+  // out args end up `void`-returning with all outputs as pointers in the
+  // generated adaptor; single-out methods return the value directly.
+  bool IsRunning() override;
+  void EnsureRunning(bool* success, std::string* error_message) override;
+  std::vector<std::tuple<std::string, std::string, std::vector<uint8_t>>>
+  ListApps() override;
+  void InstallApk(const std::string& apk_path,
+                  bool* success,
+                  std::string* error_message) override;
+  bool RemoveApp(const std::string& package_id) override;
+  bool LaunchApp(const std::string& package_id) override;
+  bool SetForeground() override;
+  bool SetBackground() override;
+
+ private:
+  // Probes container state and, if it differs from |last_known_running_|,
+  // emits ContainerStateChanged.  Caller can pass a fresh observation as
+  // |observed| to avoid a duplicate IsRunning roundtrip.
+  void MaybeEmitContainerStateChanged(bool observed);
+
+  // Periodic check that fires once after sign-in: as soon as
+  // sys.boot_completed=1 it drops cpu.shares to background and stops
+  // itself.  The container boots under LXC's default cpu.shares (1024)
+  // so Android start-up isn't throttled; this watcher hands it off to
+  // the background CPU class only after boot is done.  Set{Foreground,
+  // Background} D-Bus methods still let Chrome override afterwards.
+  void OnBootWatcherTick();
+
+  // Kicks the background cache-refresh timer.  Called on any event that
+  // could have changed the container's installed-app set (Install/Remove
+  // success, boot-complete, container-state transition to running).  The
+  // ticker retries `waydroid app list` at a fixed cadence until the CLI
+  // succeeds (which may take up to ~30s while Android's waydroidplatform
+  // binder service starts), then updates the cache and emits AppListChanged
+  // exactly once so the launcher catches up deterministically.
+  void ScheduleRefreshCache(base::TimeDelta initial_delay);
+  void RefreshCacheTick();
+
+  // Persist an icon extracted from an APK to /var/lib/waydroid_helper/
+  // icons/<package_id>.png so ListApps() can serve it back to Chrome even
+  // when the container is stopped.  Package IDs go through a light
+  // filesystem-safety check first -- anything that isn't a valid Android
+  // package name (letters, digits, '.' or '_') is refused so the on-disk
+  // layout can't be walked out of the icons directory.
+  void SaveIconForPackage(const std::string& package_id,
+                          const std::vector<uint8_t>& icon_png) const;
+  std::vector<uint8_t> LoadIconForPackage(const std::string& package_id) const;
+  void DeleteIconForPackage(const std::string& package_id) const;
+
+  WaydroidCli cli_;
+  AppCache cache_;
+  brillo::dbus_utils::DBusObject dbus_object_;
+  bool last_known_running_ = false;
+  bool background_applied_ = false;
+  base::RepeatingTimer boot_watcher_;
+  base::OneShotTimer refresh_timer_;
+  int refresh_attempts_ = 0;
+  base::WeakPtrFactory<DBusAdaptor> weak_factory_{this};
+};
+
+class Daemon : public brillo::DBusServiceDaemon {
+ public:
+  Daemon();
+  Daemon(const Daemon&) = delete;
+  Daemon& operator=(const Daemon&) = delete;
+  ~Daemon() override = default;
+
+ protected:
+  void RegisterDBusObjectsAsync(
+      brillo::dbus_utils::AsyncEventSequencer* sequencer) override;
+
+ private:
+  std::unique_ptr<DBusAdaptor> adaptor_;
+  std::unique_ptr<SuspendCoordinator> suspend_coordinator_;
+};
+
+}  // namespace waydroid_helper
+
+#endif  // WAYDROID_HELPER_DAEMON_H_

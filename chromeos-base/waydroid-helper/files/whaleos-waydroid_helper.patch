index 0000000000..ceac73e85f
--- /dev/null
+++ b/waydroid_helper/BUILD.gn
@@ -0,0 +1,57 @@
+# Copyright 2026 NAVER Authors. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//common-mk/generate-dbus-adaptors.gni")
+import("//common-mk/pkg_config.gni")
+
+group("all") {
+  deps = [
+    ":install_dbus_config",
+    ":install_init",
+    ":waydroid_helper",
+    ":waydroid_helper_adaptor",
+  ]
+}
+
+pkg_config("target_defaults") {
+  pkg_deps = [
+    "libarchive",
+    "libbrillo",
+    "libchrome",
+    # For powerd suspend-delay client protobufs (RegisterSuspendDelayRequest,
+    # SuspendImminent, SuspendReadinessInfo, ...) used by SuspendCoordinator.
+    "protobuf-lite",
+    "system_api",
+  ]
+}
+
+generate_dbus_adaptors("waydroid_helper_adaptor") {
+  dbus_service_config = "dbus_bindings/dbus-service-config.json"
+  dbus_adaptors_out_dir = "include/waydroid_helper/dbus_adaptors"
+  sources = [ "dbus_bindings/id.waydro.Helper.xml" ]
+}
+
+executable("waydroid_helper") {
+  sources = [
+    "apk_metadata.cc",
+    "app_cache.cc",
+    "daemon.cc",
+    "main.cc",
+    "suspend_coordinator.cc",
+    "waydroid_cli.cc",
+  ]
+  configs += [ ":target_defaults" ]
+  install_path = "sbin"
+  deps = [ ":waydroid_helper_adaptor" ]
+}
+
+install_config("install_dbus_config") {
+  sources = [ "dbus_bindings/id.waydro.Helper.conf" ]
+  install_path = "dbus_system_d"
+}
+
+install_config("install_init") {
+  sources = [ "init/waydroid-helper.conf" ]
+  install_path = "upstart"
+}
diff --git a/waydroid_helper/apk_metadata.cc b/waydroid_helper/apk_metadata.cc
new file mode 100644
index 0000000000..6cfa5150d1
--- /dev/null
+++ b/waydroid_helper/apk_metadata.cc
@@ -0,0 +1,954 @@
+// Copyright 2026 NAVER Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "waydroid_helper/apk_metadata.h"
+
+#include <archive.h>
+#include <archive_entry.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include <base/logging.h>
+#include <base/strings/string_util.h>
+
+// This file parses just enough of an APK's binary XML (AXML) and resource
+// table (ARSC) to extract three data points: the manifest's package name,
+// the application's launcher icon PNG, and the application's display
+// label.
+//
+// Real-world APKs (particularly ones assembled with resource shrinking /
+// path randomisation) obfuscate everything under res/, so a naive "grep
+// for res/mipmap/ic_launcher.png" scan of the zip won't work.  Instead:
+//
+//   1. Parse AndroidManifest.xml (AXML) -> icon resource id + label
+//      resource id (or literal, when the manifest inlines a string).
+//   2. Parse resources.arsc -> resolve those ids into (a) a file path
+//      inside the APK for the icon, (b) a string literal for the label.
+//   3. If the icon path resolves to an XML (adaptive icon), open that
+//      XML, walk to <foreground android:drawable="@..."/>, and follow
+//      one more indirection through the resource table to land on a PNG.
+//
+// Formats reference:
+//   https://android.googlesource.com/platform/frameworks/base/+/refs/tags/
+//   android-13.0.0_r83/libs/androidfw/include/androidfw/ResourceTypes.h
+
+namespace waydroid_helper {
+namespace {
+
+// ---------- ResChunk framing ----------
+
+constexpr uint16_t kResStringPoolType = 0x0001;
+constexpr uint16_t kResTableType = 0x0002;
+constexpr uint16_t kResXmlType = 0x0003;
+
+constexpr uint16_t kResXmlStartElementType = 0x0102;
+
+constexpr uint16_t kResTablePackageType = 0x0200;
+constexpr uint16_t kResTableTypeType = 0x0201;
+// (RES_TABLE_TYPE_SPEC_TYPE = 0x0202 exists in ARSC but we don't consume
+// spec chunks -- they only carry per-config flags we don't need.)
+
+// Res_value dataType byte.
+constexpr uint8_t kResTypeReference = 0x01;
+constexpr uint8_t kResTypeString = 0x03;
+
+// ResTable_entry.flags
+constexpr uint16_t kEntryFlagComplex = 0x0001;
+
+// ResTable_type.flags
+constexpr uint8_t kTypeFlagSparse = 0x01;
+
+// StringPool_header.flags
+constexpr uint32_t kStringPoolFlagUtf8 = 0x100;
+
+uint16_t ReadU16(const uint8_t* p) {
+  return static_cast<uint16_t>(p[0]) |
+         (static_cast<uint16_t>(p[1]) << 8);
+}
+uint32_t ReadU32(const uint8_t* p) {
+  return static_cast<uint32_t>(p[0]) |
+         (static_cast<uint32_t>(p[1]) << 8) |
+         (static_cast<uint32_t>(p[2]) << 16) |
+         (static_cast<uint32_t>(p[3]) << 24);
+}
+
+// ---------- Res_value ----------
+
+struct ResValue {
+  uint8_t data_type = 0;
+  uint32_t data = 0;
+  // Populated only when the value already carries a raw string (attribute
+  // rawValue or an ARSC entry resolved through the value pool).
+  std::string as_string;
+};
+
+// ---------- String pool ----------
+
+// A generic ResStringPool decoder.  Handles both UTF-8 (post-Honeycomb)
+// and UTF-16 pools.  We only ever read from string pools, never write, so
+// keep the API tiny.
+class StringPool {
+ public:
+  // `pool_chunk` points at the 8-byte ResChunk header of a
+  // RES_STRING_POOL_TYPE chunk; `pool_chunk_size` is the full chunk size
+  // reported in that header.
+  bool Parse(const uint8_t* pool_chunk, size_t pool_chunk_size) {
+    if (pool_chunk_size < 28) {
+      return false;
+    }
+    const uint32_t string_count = ReadU32(pool_chunk + 8);
+    const uint32_t flags = ReadU32(pool_chunk + 16);
+    const uint32_t strings_start = ReadU32(pool_chunk + 20);
+    is_utf8_ = (flags & kStringPoolFlagUtf8) != 0;
+
+    // (pool_chunk_size - 28) / 4 avoids the uint32 wrap in string_count*4.
+    if (strings_start > pool_chunk_size ||
+        string_count > (pool_chunk_size - 28u) / 4u) {
+      return false;
+    }
+    // Hard cap on entries to keep the eager vector<string> from
+    // ballooning even when pool_chunk_size is legitimately large.
+    // Sized against the largest realistic sample we've seen so far
+    // (Whale's resources.arsc declares ~305K strings), with roughly
+    // 1.7x headroom; ParsePackage() keeps type_strings and
+    // key_strings alive simultaneously, so peak memory scales with
+    // this bound multiplied by the number of live pools.  At 512K
+    // entries the eager vector still costs only ~12 MiB of empty
+    // std::strings per pool, well under the daemon's overall budget,
+    // and a hostile pool declaring millions of empty slots to force
+    // multi-hundred-megabyte allocation is rejected here.
+    constexpr uint32_t kMaxStringPoolEntries = 512000;
+    if (string_count > kMaxStringPoolEntries) {
+      LOG(WARNING) << "APK: string pool declares " << string_count
+                   << " entries -- refusing to allocate (cap "
+                   << kMaxStringPoolEntries << ")";
+      return false;
+    }
+    strings_.assign(string_count, std::string());
+    for (uint32_t i = 0; i < string_count; ++i) {
+      const uint32_t offset = ReadU32(pool_chunk + 28 + i * 4);
+      const uint32_t abs_off = strings_start + offset;
+      if (abs_off >= pool_chunk_size) {
+        continue;
+      }
+      strings_[i] = DecodeAt(pool_chunk + abs_off,
+                             pool_chunk_size - abs_off);
+    }
+    return true;
+  }
+
+  size_t size() const { return strings_.size(); }
+  const std::string& At(uint32_t idx) const {
+    static const std::string kEmpty;
+    return idx < strings_.size() ? strings_[idx] : kEmpty;
+  }
+
+ private:
+  std::string DecodeAt(const uint8_t* p, size_t max_len) const {
+    if (is_utf8_) {
+      if (max_len < 2) {
+        return {};
+      }
+      // Skip the "character length" prefix -- 1 or 2 bytes depending on
+      // whether the top bit of the first byte is set.
+      size_t off = (p[0] & 0x80) ? 2 : 1;
+      if (off >= max_len) {
+        return {};
+      }
+      // Byte length prefix uses the same 1-or-2-byte scheme.
+      uint32_t byte_len;
+      if (p[off] & 0x80) {
+        if (off + 2 > max_len) {
+          return {};
+        }
+        byte_len = ((static_cast<uint32_t>(p[off]) & 0x7F) << 8) |
+                   static_cast<uint32_t>(p[off + 1]);
+        off += 2;
+      } else {
+        byte_len = p[off];
+        off += 1;
+      }
+      if (off + byte_len > max_len) {
+        return {};
+      }
+      return std::string(reinterpret_cast<const char*>(p + off), byte_len);
+    }
+    // UTF-16LE.  We transcode to UTF-8 on the way out.
+    if (max_len < 4) {
+      return {};
+    }
+    uint32_t char_len = ReadU16(p);
+    size_t off = 2;
+    if (char_len & 0x8000) {
+      if (off + 2 > max_len) {
+        return {};
+      }
+      char_len = ((char_len & 0x7FFF) << 16) | ReadU16(p + off);
+      off += 2;
+    }
+    if (off + char_len * 2 > max_len) {
+      return {};
+    }
+    std::string out;
+    out.reserve(char_len);
+    for (uint32_t i = 0; i < char_len; ++i) {
+      const uint32_t cp = ReadU16(p + off + i * 2);
+      if (cp < 0x80) {
+        out.push_back(static_cast<char>(cp));
+      } else if (cp < 0x800) {
+        out.push_back(static_cast<char>(0xC0 | (cp >> 6)));
+        out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
+      } else if (cp < 0xD800 || cp >= 0xE000) {
+        out.push_back(static_cast<char>(0xE0 | (cp >> 12)));
+        out.push_back(static_cast<char>(0x80 | ((cp >> 6) & 0x3F)));
+        out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
+      } else {
+        out.push_back('?');  // surrogate half; unsupported
+      }
+    }
+    return out;
+  }
+
+  std::vector<std::string> strings_;
+  bool is_utf8_ = false;
+};
+
+// ---------- AXML walker ----------
+
+// Visits every START_ELEMENT in an AXML file and hands the caller the
+// element's (name, attrs) so it can pick out the parts it cares about.
+// `on_element` returns false to stop the walk early.
+struct AxmlAttr {
+  std::string_view name;
+  ResValue value;
+};
+
+using OnElementFn =
+    bool (*)(void* ctx, std::string_view name,
+             const std::vector<AxmlAttr>& attrs);
+
+bool WalkAxml(const std::vector<uint8_t>& axml,
+              void* ctx,
+              OnElementFn on_element) {
+  if (axml.size() < 16) {
+    return false;
+  }
+  const uint8_t* data = axml.data();
+  const size_t size = axml.size();
+
+  if (ReadU16(data) != kResXmlType) {
+    return false;
+  }
+  const uint32_t total = ReadU32(data + 4);
+  const size_t root_end = std::min<size_t>(total, size);
+
+  StringPool sp;
+  size_t cursor = 8;
+
+  while (cursor + 8 <= root_end) {
+    const uint16_t type = ReadU16(data + cursor);
+    const uint32_t chunk_size = ReadU32(data + cursor + 4);
+    if (chunk_size < 8 || cursor + chunk_size > root_end) {
+      return true;
+    }
+
+    if (type == kResStringPoolType) {
+      sp.Parse(data + cursor, chunk_size);
+    } else if (type == kResXmlStartElementType) {
+      const size_t node_hdr = 16;  // 8 chunk hdr + lineno u4 + comment u4
+      if (chunk_size < node_hdr + 20) {
+        cursor += chunk_size;
+        continue;
+      }
+      const uint8_t* ext = data + cursor + node_hdr;
+      const uint32_t name_idx = ReadU32(ext + 4);
+      const uint16_t attr_start = ReadU16(ext + 8);
+      const uint16_t attr_size = ReadU16(ext + 10);
+      const uint16_t attr_count = ReadU16(ext + 12);
+      const std::string& elem_name = sp.At(name_idx);
+
+      std::vector<AxmlAttr> attrs;
+      const size_t attrs_off = node_hdr + attr_start;
+      if (attr_size >= 20 &&
+          chunk_size >= attrs_off + attr_count * attr_size) {
+        const uint8_t* av = data + cursor + attrs_off;
+        attrs.reserve(attr_count);
+        for (uint16_t i = 0; i < attr_count; ++i) {
+          const uint8_t* a = av + i * attr_size;
+          const uint32_t attr_name_idx = ReadU32(a + 4);
+          const uint32_t raw_value_idx = ReadU32(a + 8);
+          const uint8_t data_type = a[15];
+          const uint32_t typed_data = ReadU32(a + 16);
+
+          AxmlAttr out;
+          out.name = sp.At(attr_name_idx);
+          out.value.data_type = data_type;
+          out.value.data = typed_data;
+          if (data_type == kResTypeString) {
+            out.value.as_string =
+                sp.At(raw_value_idx == 0xFFFFFFFFu ? typed_data
+                                                   : raw_value_idx);
+          }
+          attrs.push_back(std::move(out));
+        }
+      }
+      if (!on_element(ctx, elem_name, attrs)) {
+        return true;
+      }
+    }
+    cursor += chunk_size;
+  }
+  return true;
+}
+
+// ---------- ARSC ----------
+
+// Parsed resource table.  We only keep enough state to resolve a specific
+// resource id (0xppttiiii) into a Res_value: package id, type id (1-based
+// index into type_strings), and entry index.
+//
+// A single (typeId, entryIndex) can appear multiple times across
+// different resource configurations (different DPIs, locales, ...); we
+// keep the *first* concrete value we see, which is the "default" config
+// resource in APKs assembled by AAPT2.  That's good enough for launcher
+// icon / app label resolution because those are supplied under the
+// default config in every APK we've seen.
+class ResourceTable {
+ public:
+  // `arsc` points at the start of the resources.arsc payload.  Returns
+  // false on any structural error; the table is unusable in that case.
+  bool Parse(const std::vector<uint8_t>& arsc) {
+    if (arsc.size() < 12 || ReadU16(arsc.data()) != kResTableType) {
+      return false;
+    }
+    const uint32_t total = ReadU32(arsc.data() + 4);
+    const size_t end = std::min<size_t>(total, arsc.size());
+    // ResTable_header adds a uint32 packageCount after the ResChunk_header.
+    // header_size gives us where children start.
+    const uint16_t header_size = ReadU16(arsc.data() + 2);
+    size_t cursor = header_size;
+    while (cursor + 8 <= end) {
+      const uint16_t type = ReadU16(arsc.data() + cursor);
+      const uint32_t chunk_size = ReadU32(arsc.data() + cursor + 4);
+      if (chunk_size < 8 || cursor + chunk_size > end) {
+        break;
+      }
+      if (type == kResStringPoolType) {
+        global_value_pool_.Parse(arsc.data() + cursor, chunk_size);
+      } else if (type == kResTablePackageType) {
+        ParsePackage(arsc.data() + cursor, chunk_size);
+      }
+      cursor += chunk_size;
+    }
+    return true;
+  }
+
+  // Resolve a resource id into its stored Res_value (data + raw string
+  // where applicable).  Returns nullopt if the id doesn't map to
+  // anything, or the value it maps to is a "complex" bag (styles/arrays,
+  // which we can't consume).  Recursively follows TYPE_REFERENCE chains
+  // for up to `kMaxIndirection` hops -- resource shrinking sometimes
+  // produces `alias` entries that just point at another id.
+  std::optional<ResValue> Resolve(uint32_t id) const {
+    constexpr int kMaxIndirection = 4;
+    for (int hop = 0; hop < kMaxIndirection; ++hop) {
+      const auto it = entries_by_id_.find(id);
+      if (it == entries_by_id_.end()) {
+        return std::nullopt;
+      }
+      ResValue v = it->second;
+      if (v.data_type != kResTypeReference || v.data == 0 || v.data == id) {
+        return v;
+      }
+      id = v.data;
+    }
+    return std::nullopt;
+  }
+
+ private:
+  void ParsePackage(const uint8_t* pkg, uint32_t size) {
+    if (size < 288) {
+      return;
+    }
+    const uint32_t package_id = ReadU32(pkg + 8);
+    const uint32_t type_strings_off = ReadU32(pkg + 12 + 128 * 2);
+    const uint32_t key_strings_off = ReadU32(pkg + 12 + 128 * 2 + 8);
+
+    StringPool type_strings;
+    StringPool key_strings;
+    // size >= 288 guarantees size - 8 doesn't underflow; the pool's
+    // self-declared sz must fit within the package chunk.
+    if (type_strings_off != 0 && type_strings_off <= size - 8) {
+      const uint32_t sz = ReadU32(pkg + type_strings_off + 4);
+      if (sz <= size - type_strings_off) {
+        type_strings.Parse(pkg + type_strings_off, sz);
+      }
+    }
+    if (key_strings_off != 0 && key_strings_off <= size - 8) {
+      const uint32_t sz = ReadU32(pkg + key_strings_off + 4);
+      if (sz <= size - key_strings_off) {
+        key_strings.Parse(pkg + key_strings_off, sz);
+      }
+    }
+    (void)key_strings;  // Not needed for our lookups; parsed for debug.
+
+    // Walk chunks after the last string pool.  ResTable_type chunks carry
+    // (typeId, config, entryCount, entries...).
+    const uint16_t header_size = ReadU16(pkg + 2);
+    size_t cursor = header_size;
+    if (type_strings_off != 0 && type_strings_off <= size - 8) {
+      const uint32_t sz = ReadU32(pkg + type_strings_off + 4);
+      if (sz <= size - type_strings_off) {
+        cursor = std::max<size_t>(cursor, type_strings_off + sz);
+      }
+    }
+    if (key_strings_off != 0 && key_strings_off <= size - 8) {
+      const uint32_t sz = ReadU32(pkg + key_strings_off + 4);
+      if (sz <= size - key_strings_off) {
+        cursor = std::max<size_t>(cursor, key_strings_off + sz);
+      }
+    }
+    while (cursor + 8 <= size) {
+      const uint16_t chunk_type = ReadU16(pkg + cursor);
+      const uint32_t chunk_size = ReadU32(pkg + cursor + 4);
+      if (chunk_size < 8 || cursor + chunk_size > size) {
+        break;
+      }
+      if (chunk_type == kResTableTypeType) {
+        ParseType(pkg + cursor, chunk_size, package_id);
+      }
+      cursor += chunk_size;
+    }
+  }
+
+  void ParseType(const uint8_t* chunk, uint32_t chunk_size,
+                 uint32_t package_id) {
+    // ResTable_type layout:
+    //   ResChunk_header (8)
+    //   uint8 id
+    //   uint8 flags
+    //   uint16 reserved
+    //   uint32 entryCount
+    //   uint32 entriesStart
+    //   ResTable_config config (variable)
+    //   uint32 entryOffsets[entryCount]  (dense)
+    //     OR uint16 idx, uint16 offset  (sparse, indexed by header order)
+    //   ResTable_entry blob
+    if (chunk_size < 20) {
+      return;
+    }
+    const uint8_t type_id = chunk[8];
+    const uint8_t flags = chunk[9];
+    const uint32_t entry_count = ReadU32(chunk + 12);
+    const uint32_t entries_start = ReadU32(chunk + 16);
+    if (type_id == 0 || entries_start > chunk_size) {
+      return;
+    }
+
+    const uint16_t header_size = ReadU16(chunk + 2);
+    const size_t offsets_off = header_size;
+    const bool sparse = (flags & kTypeFlagSparse) != 0;
+    const size_t stride = sparse ? 4u : 4u;
+    if (offsets_off + entry_count * stride > chunk_size) {
+      return;
+    }
+
+    // Only cache resources from package 0x7f (the app's own package).
+    // Framework or shared library ids (0x01/0x02/...) are outside our
+    // scope; those already work everywhere anyway.
+    if (package_id != 0x7fu) {
+      return;
+    }
+
+    for (uint32_t i = 0; i < entry_count; ++i) {
+      uint32_t entry_index = i;
+      uint32_t off;
+      if (sparse) {
+        const uint16_t idx = ReadU16(chunk + offsets_off + i * 4);
+        const uint16_t entry_off = ReadU16(chunk + offsets_off + i * 4 + 2);
+        entry_index = idx;
+        off = static_cast<uint32_t>(entry_off) * 4u;
+      } else {
+        off = ReadU32(chunk + offsets_off + i * 4);
+      }
+      if (off == 0xFFFFFFFFu) {
+        continue;
+      }
+      const size_t entry_abs = entries_start + off;
+      if (entry_abs + 8 > chunk_size) {
+        continue;
+      }
+      const uint16_t entry_size = ReadU16(chunk + entry_abs);
+      const uint16_t entry_flags = ReadU16(chunk + entry_abs + 2);
+      // Skip complex (bag) entries -- styles/arrays -- we can't collapse
+      // them to a single value.
+      if (entry_flags & kEntryFlagComplex) {
+        continue;
+      }
+      // ResTable_entry is followed by a Res_value at entry_size:
+      //   uint16 size, uint8 res0, uint8 dataType, uint32 data.
+      const size_t rv_off = entry_abs + entry_size;
+      if (rv_off + 8 > chunk_size) {
+        continue;
+      }
+      ResValue v;
+      v.data_type = chunk[rv_off + 3];
+      v.data = ReadU32(chunk + rv_off + 4);
+      if (v.data_type == kResTypeString) {
+        v.as_string = global_value_pool_.At(v.data);
+      }
+      const uint32_t id =
+          (package_id << 24) | (static_cast<uint32_t>(type_id) << 16) |
+          entry_index;
+      entries_by_id_.emplace(id, std::move(v));
+    }
+  }
+
+  StringPool global_value_pool_;
+  std::unordered_map<uint32_t, ResValue> entries_by_id_;
+};
+
+// ---------- Zip helpers (libarchive) ----------
+
+// Cached, indexed contents of an APK zip file.  libarchive is stream-only
+// so we read every entry we might care about upfront into memory.  Icon
+// PNGs are ~20-200 KB, resources.arsc is ~1-5 MB for large apps; the peak
+// footprint is well under 50 MB per install call and lives just for the
+// duration of ExtractApkMetadata.
+struct ApkContents {
+  std::vector<uint8_t> android_manifest;   // AndroidManifest.xml (AXml)
+  std::vector<uint8_t> resources_arsc;     // resources.arsc
+  std::unordered_map<std::string, std::vector<uint8_t>> res_files;
+};
+
+// Zip-bomb defenses.  APKs come from untrusted downloads via Files/Chrome
+// and this daemon runs as root with oom_score_adj=-100, so an unbounded
+// inflate could take down the entire system before the kernel notices.
+// Per-entry caps stop a single compressed entry from expanding without
+// bound; the total cap stops a swarm of medium-sized entries.
+//
+// kMaxSingleEntryBytes was raised from 32 MiB because real APKs routinely
+// ship a resources.arsc larger than 32 MiB (Play Store frontends, Whale,
+// etc.) and the smaller cap aborted metadata extraction before the
+// manifest was reached, leaving the launcher without an icon.  96 MiB
+// covers the legitimate long tail while keeping a single entry bounded;
+// abort paths log which entry hit the cap so future adjustments have
+// direct evidence.
+//
+// kMaxTotalContentBytes stays at the original 64 MiB.  The earlier
+// bump to 192 MiB was to leave headroom for large res/raw / res/font
+// assets, but IsUninterestingResSubdir() below now skips those
+// subdirs at archive-walk time, so they never contribute to the total.
+// Under this scope, real launcher-relevant entries (manifest +
+// resources.arsc + mipmap/drawable icons) sit well below 64 MiB.
+constexpr size_t kMaxSingleEntryBytes = 96 * 1024 * 1024;   // 96 MiB
+constexpr size_t kMaxTotalContentBytes = 64 * 1024 * 1024;  // 64 MiB
+
+// res/ subdirectories we never need for launcher icon extraction. Skip
+// them at archive-walk time so a fat raw asset (audio, video, large
+// animations) can't blow either the single-entry or total-bytes cap
+// and abort the whole metadata pass.
+bool IsUninterestingResSubdir(std::string_view path) {
+  // Fast prefix checks -- Android resource dirs are all "res/<kind>-..."
+  // (optionally suffixed with density/config qualifiers).
+  constexpr std::string_view kSkip[] = {
+      "res/raw/", "res/raw-",
+      "res/xml/", "res/xml-",
+      "res/anim/", "res/anim-",
+      "res/animator/", "res/animator-",
+      "res/font/", "res/font-",
+      "res/interpolator/", "res/interpolator-",
+      "res/menu/", "res/menu-",
+      "res/transition/", "res/transition-",
+      "res/values/", "res/values-",
+  };
+  for (std::string_view p : kSkip) {
+    if (path.starts_with(p)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Structural caps that don't rely on byte totals. An attacker can put
+// millions of *empty* res/ entries with unique names into a zip: the
+// total-bytes cap never trips, but the unordered_map nodes and the
+// path strings themselves eat memory and CPU. Bound the raw entry
+// count we're willing to enumerate, the number of res/ entries we're
+// willing to store, and the pathname length of any one entry we keep.
+// Real APKs have <10K entries and <5K under res/; pathnames rarely
+// pass 256 bytes.
+constexpr size_t kMaxArchiveEntries = 200000;
+constexpr size_t kMaxResEntries = 50000;
+constexpr size_t kMaxEntryPathLen = 4096;
+
+bool ReadCurrentEntry(struct archive* a,
+                      size_t max_bytes,
+                      std::vector<uint8_t>* out) {
+  constexpr size_t kBufSize = 32 * 1024;
+  uint8_t buf[kBufSize];
+  out->clear();
+  for (;;) {
+    la_ssize_t n = archive_read_data(a, buf, sizeof(buf));
+    if (n == 0) {
+      return true;
+    }
+    if (n < 0) {
+      LOG(WARNING) << "APK: archive_read_data: "
+                   << archive_error_string(a);
+      out->clear();
+      return false;
+    }
+    if (out->size() + static_cast<size_t>(n) > max_bytes) {
+      LOG(WARNING) << "APK: entry exceeds size cap (" << max_bytes
+                   << " bytes) -- refusing to inflate further";
+      out->clear();
+      return false;
+    }
+    out->insert(out->end(), buf, buf + n);
+  }
+}
+
+bool ReadApk(const base::FilePath& apk_path, ApkContents* out) {
+  struct archive* a = archive_read_new();
+  if (!a) {
+    return false;
+  }
+  archive_read_support_format_zip(a);
+  const int rc = archive_read_open_filename(a, apk_path.value().c_str(),
+                                            /*block_size=*/64 * 1024);
+  if (rc != ARCHIVE_OK) {
+    LOG(WARNING) << "APK: cannot open " << apk_path.value() << ": "
+                 << archive_error_string(a);
+    archive_read_free(a);
+    return false;
+  }
+  size_t total_bytes = 0;
+  size_t entries_seen = 0;
+  bool aborted = false;
+  const auto remaining = [&]() -> size_t {
+    return total_bytes < kMaxTotalContentBytes
+               ? kMaxTotalContentBytes - total_bytes
+               : 0;
+  };
+  const auto per_entry_cap = [&]() -> size_t {
+    return std::min<size_t>(kMaxSingleEntryBytes, remaining());
+  };
+  struct archive_entry* entry = nullptr;
+  while (!aborted &&
+         archive_read_next_header(a, &entry) == ARCHIVE_OK) {
+    if (++entries_seen > kMaxArchiveEntries) {
+      LOG(WARNING) << "APK: exceeds archive entry cap ("
+                   << kMaxArchiveEntries << ")";
+      aborted = true;
+      break;
+    }
+    const char* c_path = archive_entry_pathname(entry);
+    if (!c_path) {
+      archive_read_data_skip(a);
+      continue;
+    }
+    // Bound the pathname length before we ever construct a std::string
+    // from it: otherwise millions of entries with multi-KiB names still
+    // charge us for the path storage even when we would skip the entry.
+    const size_t path_len = strlen(c_path);
+    if (path_len > kMaxEntryPathLen) {
+      LOG(WARNING) << "APK: entry pathname too long (" << path_len
+                   << " bytes); skipping";
+      archive_read_data_skip(a);
+      continue;
+    }
+    std::string path(c_path, path_len);
+    if (path == "AndroidManifest.xml") {
+      if (!ReadCurrentEntry(a, per_entry_cap(), &out->android_manifest)) {
+        LOG(WARNING) << "APK: AndroidManifest.xml exceeded per-entry cap";
+        aborted = true;
+        break;
+      }
+      total_bytes += out->android_manifest.size();
+    } else if (path == "resources.arsc") {
+      if (!ReadCurrentEntry(a, per_entry_cap(), &out->resources_arsc)) {
+        LOG(WARNING) << "APK: resources.arsc exceeded per-entry cap";
+        aborted = true;
+        break;
+      }
+      total_bytes += out->resources_arsc.size();
+    } else if (base::StartsWith(path, "res/",
+                                base::CompareCase::SENSITIVE)) {
+      // Skip res/ subdirs unrelated to launcher icon lookup (raw, xml,
+      // anim, ...) -- these are the ones that occasionally ship huge
+      // media assets that used to blow the per-entry byte cap and
+      // abort the whole metadata pass.
+      if (IsUninterestingResSubdir(path)) {
+        archive_read_data_skip(a);
+        continue;
+      }
+      // Cap the number of res/ entries we're willing to remember. This
+      // is a separate limit from the byte total because an attacker can
+      // send an arbitrary number of empty res/ entries that never
+      // increment total_bytes; each still costs a map node and a
+      // pathname string.
+      if (out->res_files.size() >= kMaxResEntries) {
+        LOG(WARNING) << "APK: exceeds res/ entry cap (" << kMaxResEntries
+                     << ")";
+        aborted = true;
+        break;
+      }
+      // Keep every res/ entry so we can serve any path resources.arsc
+      // resolves to without a second archive pass.
+      std::vector<uint8_t> content;
+      if (!ReadCurrentEntry(a, per_entry_cap(), &content)) {
+        LOG(WARNING) << "APK: entry " << path
+                     << " exceeded per-entry cap";
+        aborted = true;
+        break;
+      }
+      total_bytes += content.size();
+      // Also charge the total budget for the pathname storage so a
+      // stream of medium-sized names can't stay under the radar of
+      // byte totals that only counted payload.
+      total_bytes += path.size();
+      if (total_bytes > kMaxTotalContentBytes) {
+        LOG(WARNING) << "APK: pathname/payload total exceeds cap ("
+                     << kMaxTotalContentBytes << ")";
+        aborted = true;
+        break;
+      }
+      out->res_files.emplace(std::move(path), std::move(content));
+    } else {
+      archive_read_data_skip(a);
+    }
+  }
+  archive_read_free(a);
+  if (aborted) {
+    LOG(WARNING) << "APK: metadata extraction aborted for "
+                 << apk_path.value()
+                 << " (byte or structural cap exceeded)";
+    return false;
+  }
+  return !out->android_manifest.empty();
+}
+
+// ---------- Manifest walker ----------
+
+struct ManifestFields {
+  std::string package;
+  ResValue label;
+  ResValue icon;
+};
+
+bool OnManifestElement(void* ctx, std::string_view name,
+                       const std::vector<AxmlAttr>& attrs) {
+  auto* fields = static_cast<ManifestFields*>(ctx);
+  if (name == "manifest") {
+    for (const auto& a : attrs) {
+      if (a.name == "package" && a.value.data_type == kResTypeString) {
+        fields->package = a.value.as_string;
+      }
+    }
+  } else if (name == "application") {
+    for (const auto& a : attrs) {
+      if (a.name == "label") {
+        fields->label = a.value;
+      } else if (a.name == "icon") {
+        fields->icon = a.value;
+      }
+    }
+    // Nothing else in the manifest interests us; stop early.
+    return false;
+  }
+  return true;
+}
+
+// ---------- Adaptive icon walker ----------
+
+struct AdaptiveIconRef {
+  bool found = false;
+  uint32_t drawable_id = 0;
+};
+
+bool OnAdaptiveIconElement(void* ctx, std::string_view name,
+                           const std::vector<AxmlAttr>& attrs) {
+  auto* out = static_cast<AdaptiveIconRef*>(ctx);
+  // Prefer monochrome / foreground; ignore background (usually a solid
+  // colour that produces a boring tile once flattened).
+  if (name != "foreground" && name != "monochrome") {
+    return true;
+  }
+  for (const auto& a : attrs) {
+    if (a.name == "drawable" && a.value.data_type == kResTypeReference) {
+      out->found = true;
+      out->drawable_id = a.value.data;
+      // <foreground> wins if we see it, but we still keep walking so a
+      // later element could produce a better match.  In practice
+      // AdaptiveIcon has at most one <foreground>, so this is a no-op.
+      return name != "foreground";
+    }
+  }
+  return true;
+}
+
+// ---------- Density-ranked file path pick ----------
+
+int DensityRank(std::string_view path) {
+  if (path.find("xxxhdpi") != std::string_view::npos) return 6;
+  if (path.find("xxhdpi") != std::string_view::npos) return 5;
+  if (path.find("xhdpi") != std::string_view::npos) return 4;
+  if (path.find("hdpi") != std::string_view::npos) return 3;
+  if (path.find("mdpi") != std::string_view::npos) return 2;
+  if (path.find("ldpi") != std::string_view::npos) return 1;
+  return 0;
+}
+
+// Resolve a resource id representing an icon into raw PNG bytes.  Follows
+// one level of adaptive-icon indirection if the id lands on an XML.
+std::vector<uint8_t> ResolveIconPng(const ResourceTable& rt,
+                                    const ApkContents& apk,
+                                    uint32_t icon_id) {
+  auto val = rt.Resolve(icon_id);
+  if (!val || val->data_type != kResTypeString || val->as_string.empty()) {
+    return {};
+  }
+  const std::string& first_path = val->as_string;
+  if (base::EndsWith(first_path, ".png",
+                     base::CompareCase::INSENSITIVE_ASCII) ||
+      base::EndsWith(first_path, ".webp",
+                     base::CompareCase::INSENSITIVE_ASCII)) {
+    auto it = apk.res_files.find(first_path);
+    if (it != apk.res_files.end()) {
+      return it->second;
+    }
+    return {};
+  }
+  if (base::EndsWith(first_path, ".xml",
+                     base::CompareCase::INSENSITIVE_ASCII)) {
+    auto it = apk.res_files.find(first_path);
+    if (it == apk.res_files.end()) {
+      return {};
+    }
+    AdaptiveIconRef ref;
+    WalkAxml(it->second, &ref, OnAdaptiveIconElement);
+    if (!ref.found) {
+      return {};
+    }
+    // The foreground/monochrome id can itself resolve to a bunch of
+    // density variants -- the resource table only exposes the default one
+    // through Resolve() (that's the "first config wins" behaviour we
+    // documented above).  Follow it.
+    auto inner = rt.Resolve(ref.drawable_id);
+    if (!inner || inner->data_type != kResTypeString ||
+        inner->as_string.empty()) {
+      return {};
+    }
+    auto it2 = apk.res_files.find(inner->as_string);
+    if (it2 == apk.res_files.end()) {
+      return {};
+    }
+    return it2->second;
+  }
+  return {};
+}
+
+// Best-effort path when resources.arsc doesn't tell us anything (e.g.
+// malformed table, older APK).  Enumerates res/mipmap-*/ and
+// res/drawable-*/ for ic_launcher-shaped PNGs and picks the highest
+// density.
+std::vector<uint8_t> FallbackIconFromWellKnownPaths(const ApkContents& apk) {
+  std::vector<uint8_t> best;
+  int best_rank = -1;
+  for (const auto& [path, bytes] : apk.res_files) {
+    const bool is_icon_dir =
+        base::StartsWith(path, "res/mipmap",
+                         base::CompareCase::SENSITIVE) ||
+        base::StartsWith(path, "res/drawable",
+                         base::CompareCase::SENSITIVE);
+    const bool is_png =
+        base::EndsWith(path, ".png", base::CompareCase::INSENSITIVE_ASCII);
+    const bool looks_like_launcher =
+        path.find("ic_launcher") != std::string_view::npos ||
+        path.find("app_icon") != std::string_view::npos ||
+        path.find("launcher_icon") != std::string_view::npos;
+    if (!is_icon_dir || !is_png || !looks_like_launcher) {
+      continue;
+    }
+    const bool is_round =
+        path.find("ic_launcher_round") != std::string_view::npos;
+    const bool is_foreground =
+        path.find("_foreground") != std::string_view::npos ||
+        path.find("_background") != std::string_view::npos;
+    int rank = DensityRank(path);
+    if (is_round) rank -= 20;
+    if (is_foreground) rank -= 40;
+    if (rank <= best_rank) {
+      continue;
+    }
+    best = bytes;
+    best_rank = rank;
+  }
+  return best;
+}
+
+// Resolve a label attribute value.  If the manifest inlined a literal,
+// use that; otherwise chase the reference through the resource table.
+std::string ResolveLabel(const ResourceTable& rt, const ResValue& label) {
+  if (label.data_type == kResTypeString) {
+    return label.as_string;
+  }
+  if (label.data_type != kResTypeReference || label.data == 0) {
+    return {};
+  }
+  auto val = rt.Resolve(label.data);
+  if (!val || val->data_type != kResTypeString) {
+    return {};
+  }
+  return val->as_string;
+}
+
+}  // namespace
+
+std::optional<ApkMetadata> ExtractApkMetadata(const base::FilePath& apk_path) {
+  ApkContents apk;
+  if (!ReadApk(apk_path, &apk)) {
+    return std::nullopt;
+  }
+
+  ManifestFields fields;
+  if (!WalkAxml(apk.android_manifest, &fields, OnManifestElement)) {
+    return std::nullopt;
+  }
+  if (fields.package.empty()) {
+    LOG(WARNING) << "APK: no <manifest package> in " << apk_path.value();
+    return std::nullopt;
+  }
+
+  ResourceTable rt;
+  const bool arsc_ok = !apk.resources_arsc.empty() &&
+                       rt.Parse(apk.resources_arsc);
+
+  ApkMetadata md;
+  md.package_id = std::move(fields.package);
+  if (arsc_ok) {
+    md.label = ResolveLabel(rt, fields.label);
+    if (fields.icon.data_type == kResTypeReference && fields.icon.data) {
+      md.icon_png = ResolveIconPng(rt, apk, fields.icon.data);
+    }
+  }
+  // Path A relies on the resource table.  If it produced nothing, fall
+  // back to the pre-ARSC heuristic so APKs that don't obfuscate their
+  // res/ layout still get an icon.
+  if (md.icon_png.empty()) {
+    md.icon_png = FallbackIconFromWellKnownPaths(apk);
+  }
+  return md;
+}
+
+}  // namespace waydroid_helper

+#include <brillo/whaleos_util.h>
+
 #include <base/functional/callback.h>
 #include <base/functional/callback_helpers.h>
 #include <base/logging.h>
@@ -111,6 +113,15 @@ void MiddlewareOwner::InitBackend() {
 
   metrics_ = std::make_unique<Metrics>();
 
+  // For devices without TPM, skip proxy initialization
+  // This avoids the 30-second timeout waiting for TPM services
+  if (brillo::IsNoTpmModel()) {
+    LOG(INFO) << "Known non-TPM model detected, skipping hwsec backend initialization";
+    // Don't initialize proxy or backend for non-TPM devices
+    // The frontend will handle the missing backend gracefully
+    return;
+  }
+
   TPM_SELECT_BEGIN;
   TPM1_SECTION({
     auto proxy = std::make_unique<ProxyImpl>();

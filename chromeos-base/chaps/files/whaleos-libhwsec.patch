+    const brillo::SecureBlob& le_secret,
+    const brillo::SecureBlob& he_secret,
+    const brillo::SecureBlob& reset_secret,
+    const DelaySchedule& delay_schedule,
+    std::optional<uint32_t> expiration_delay,
+    InsertCredentialCallback callback) const {
+  // FIXME(changwan.hong): Not async.
+  StatusOr<uint64_t> new_label = InsertCredential(policies,
+      le_secret, he_secret, reset_secret, delay_schedule, expiration_delay);
+  std::move(callback).Run(std::move(new_label));
+}

+  base::FilePath file_path;
+  std::string attached_log;
+};
+
+// Sender subclass that records the NELO upload(s) RequestToSendCrash()
+// performs, instead of making a real network request.
+class RecordingNeloSender : public util::Sender {
+ public:
+  using util::Sender::Sender;
+
+  std::vector<NeloUpload> uploads;
+
+  // Exposes the protected RequestToSendCrash() to the test body.
+  SenderBase::CrashRemoveReason RequestToSendCrashForTest(
+      const CrashDetails& details) {
+    return RequestToSendCrash(details);
+  }
+
+ protected:
+  bool SendFileToNelo(const CrashDetails& details,
+                      const base::FilePath& file_path,
+                      const std::string& attached_log) override {
+    uploads.push_back({file_path, attached_log});
+    return true;
+  }
+};
+
+// Verifies that RequestToSendCrash() uploads the crash payload in a single NELO
+// request with the attached .log (upload_file_log) embedded, so the call stack
+// and the failure-cause log land in the same NELO event (and can be paired).
+// Non-.log attachments (e.g. .bin) must not be embedded, and the .log must not
+// be uploaded as a separate request.
+TEST_F(CrashSenderUtilTest, RequestToSendCrashEmbedsAttachedLogIntoPayload) {
+  const base::FilePath system_dir = paths::Get(paths::kSystemCrashDirectory);
+  ASSERT_TRUE(base::CreateDirectory(system_dir));
+
+  const base::FilePath payload_file("0.0.0.0.0.dmp");
+  ASSERT_TRUE(
+      test_util::CreateFile(system_dir.Append(payload_file), "fake_dmp"));
+
+  const base::FilePath log_file("0.0.0.0.0.log");
+  const std::string log_contents = "===/var/log/messages===\nfailure cause";
+  ASSERT_TRUE(test_util::CreateFile(system_dir.Append(log_file), log_contents));
+
+  // A non-log attachment that must not be embedded as the crash log.
+  const base::FilePath bin_file("data.bin");
+  ASSERT_TRUE(test_util::CreateFile(system_dir.Append(bin_file), "fake_bin"));
+
+  brillo::KeyValueStore metadata;
+  metadata.SetString("exec_name", "cryptohomed");
+  metadata.SetString("ver", "fake_chromeos_ver");
+  metadata.SetString("upload_file_log", log_file.value());
+  metadata.SetString("upload_file_foofile", bin_file.value());
+
+  CrashDetails details = {
+      .meta_file = system_dir.Append("0.0.0.0.0.meta"),
+      .payload_file = system_dir.Append(payload_file),
+      .payload_kind = "minidump",
+      .client_id = kFakeClientId,
+      .metadata = metadata,
+  };
+
+  Sender::Options options;
+  RecordingNeloSender sender(
+      nullptr, std::make_unique<test_util::AdvancingClock>(), options);
+
+  EXPECT_EQ(sender.RequestToSendCrashForTest(details),
+            SenderBase::CrashRemoveReason::kFinishedUploading);
+
+  // Exactly one upload: the payload, carrying the .log contents (not the .bin).
+  ASSERT_EQ(sender.uploads.size(), 1u);
+  EXPECT_EQ(sender.uploads[0].file_path, system_dir.Append(payload_file));
+  EXPECT_EQ(sender.uploads[0].attached_log, log_contents);
+}
+
+// When a crash carries multiple .log attachments, only upload_file_log (the
+// cryptohome failure-cause log) must be embedded -- not another .log that
+// happens to sort earlier (e.g. upload_file_ec_log). Guards against matching by
+// ".log" suffix over the KeyValueStore's key-sorted iteration order.
+TEST_F(CrashSenderUtilTest, RequestToSendCrashEmbedsOnlyUploadFileLog) {
+  const base::FilePath system_dir = paths::Get(paths::kSystemCrashDirectory);
+  ASSERT_TRUE(base::CreateDirectory(system_dir));
+
+  const base::FilePath payload_file("0.0.0.0.0.dmp");
+  ASSERT_TRUE(
+      test_util::CreateFile(system_dir.Append(payload_file), "fake_dmp"));
+
+  // "ec_log" sorts before "log" in the meta's key order; it must be ignored.
+  const base::FilePath ec_log_file("0.0.0.0.0.ec.log");
+  ASSERT_TRUE(
+      test_util::CreateFile(system_dir.Append(ec_log_file), "ec log content"));
+
+  const base::FilePath log_file("0.0.0.0.0.log");
+  const std::string log_contents = "cryptohome failure cause";
+  ASSERT_TRUE(test_util::CreateFile(system_dir.Append(log_file), log_contents));
+
+  brillo::KeyValueStore metadata;
+  metadata.SetString("ver", "fake_chromeos_ver");
+  metadata.SetString("upload_file_ec_log", ec_log_file.value());
+  metadata.SetString("upload_file_log", log_file.value());
+
+  CrashDetails details = {
+      .meta_file = system_dir.Append("0.0.0.0.0.meta"),
+      .payload_file = system_dir.Append(payload_file),
+      .payload_kind = "minidump",
+      .client_id = kFakeClientId,
+      .metadata = metadata,
+  };
+
+  Sender::Options options;
+  RecordingNeloSender sender(
+      nullptr, std::make_unique<test_util::AdvancingClock>(), options);
+
+  EXPECT_EQ(sender.RequestToSendCrashForTest(details),
+            SenderBase::CrashRemoveReason::kFinishedUploading);
+
+  ASSERT_EQ(sender.uploads.size(), 1u);
+  EXPECT_EQ(sender.uploads[0].attached_log, log_contents);
+}
+
+// When there is no attached .log, the payload is still uploaded, with an empty
+// embedded log.
+TEST_F(CrashSenderUtilTest, RequestToSendCrashWithoutAttachedLog) {
+  const base::FilePath system_dir = paths::Get(paths::kSystemCrashDirectory);
+  ASSERT_TRUE(base::CreateDirectory(system_dir));
+
+  const base::FilePath payload_file("0.0.0.0.0.dmp");
+  ASSERT_TRUE(

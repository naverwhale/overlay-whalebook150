+
+#include "crash-reporter/crashpad/http_body.h"
+#include "crash-reporter/crashpad/http_headers.h"
+
+// Copied from whale browser
+// src/whale/third_party/crashpad/crashpad/util/net/http_nelo_builder.h
+
+namespace crashpad {
+
+class HTTPBodyStream;
+
+//! \brief This class is used to build a JSON message for use as a HTTP request
+//! body for NELO server.
+class HTTPNeloBuilder {
+ public:
+  // A format of file. Text or binary.
+  enum class FileFormat {
+    Text,
+    Bin,
+  };
+
+  enum class ExceptionType {
+    None,
+    KernelCrash,
+    UpdateFailure,
+    FirmwareError,
+    GpuError,
+  };
+
+  HTTPNeloBuilder(const std::string& nelo_project_name,
+                  const std::string& product_version);
+  ~HTTPNeloBuilder();
+
+  //! \brief Sets a nelo field, which will be shown on nelo web page as an
+  //! individual field.
+  void SetField(const std::string& key, const std::string& value);
+
+  //! \brief Sets a nelo annotation, which will be shown in "CustomMessage"
+  //! field on nelo web page.
+  void SetAnnotation(const std::string& key, const std::string& value);
+
+  void SetExceptionType(ExceptionType type);
+
+  // Sets an information about the file to upload.
+  void SetFileInfo(const base::FilePath& file_path,
+                   FileFormat file_format,
+                   bool is_crash_dump);
+
+  //! \brief Generates the HTTPBodyStream for the data currently supplied to
+  //!     the builder.
+  //!
+  //! \return A caller-owned HTTPBodyStream object.
+  std::unique_ptr<HTTPBodyStream> GetBodyStream();
+
+  //! \brief Adds the appropriate content headers to \a http_headers.
+  //!
+  //! Any headers that this method adds will replace existing headers by the
+  //! same name in \a http_headers.
+  void PopulateContentHeaders(HTTPHeaders* http_headers) const;
+
+ private:
+  std::string GetAnnotationsInJson() const;
+  std::string ReadFile() const;
+
+  const std::string nelo_project_name_;
+  const std::string product_version_;
+  base::DictValue fields_;
+  base::DictValue annotations_;
+  base::FilePath file_path_;
+  FileFormat file_format_ = FileFormat::Bin;
+  bool is_crash_dump_ = true;
+  ExceptionType exception_type_ = ExceptionType::None;
+};
+
+}  // namespace util
+
+#endif  // CRASH_REPORTER_CRASHPAD_HTTP_NELO_BUILDER_H_

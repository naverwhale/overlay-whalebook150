diff --git a/crash-reporter/crashpad/http_nelo_builder.cc b/crash-reporter/crashpad/http_nelo_builder.cc
new file mode 100644
index 0000000000..0847543432
--- /dev/null
+++ b/crash-reporter/crashpad/http_nelo_builder.cc
@@ -0,0 +1,168 @@
+// Copyright 2021 NAVER Corp. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "crash-reporter/crashpad/http_nelo_builder.h"
+
+#include <base/base64.h>
+#include <base/files/file_util.h>
+#include <base/json/json_writer.h>
+#include <base/logging.h>
+#include <base/strings/string_util.h>
+#include <base/system/sys_info.h>
+#include <base/time/time.h>
+#include <base/values.h>
+
+#include "crash-reporter/crashpad/http_body.h"
+#include "crash-reporter/crashpad/http_body_gzip.h"
+
+// Nelo accepts only a few fixed platform keywords for uploading crash dumps.
+// https://example.com
+#if defined(OS_APPLE)
+// On MacOS, We use a special platform name for uploading a dump file so that
+// nelo server can treat it as a windows symbols. See
+// https://example.com for details.
+#define PLATFORM_NAME "windows osx"
+#elif defined(OS_WIN)
+#define PLATFORM_NAME "windows"
+#elif defined(OS_LINUX) || defined(OS_CHROMEOS)
+#define PLATFORM_NAME "linux"
+#elif
+#define PLATFORM_NAME "unknown"
+#endif
+
+namespace crashpad {
+
+namespace {
+std::string ToString(HTTPNeloBuilder::FileFormat file_format) {
+  std::string str;
+  switch (file_format) {
+    case HTTPNeloBuilder::FileFormat::Text:
+      str = "txt";
+      break;
+    case HTTPNeloBuilder::FileFormat::Bin:
+      str = "bin";
+      break;
+  }
+  return str;
+}
+}  // namespace
+
+HTTPNeloBuilder::HTTPNeloBuilder(const std::string& nelo_project_name,
+                                 const std::string& product_version)
+    : nelo_project_name_(nelo_project_name),
+      product_version_(product_version) {}
+
+HTTPNeloBuilder::~HTTPNeloBuilder() {}
+
+void HTTPNeloBuilder::SetField(const std::string& key,
+                               const std::string& value) {
+  fields_.Set(key, base::Value(value));
+}
+
+void HTTPNeloBuilder::SetAnnotation(const std::string& key,
+                                    const std::string& value) {
+  annotations_.Set(key, base::Value(value));
+}
+
+void HTTPNeloBuilder::SetExceptionType(ExceptionType type) {
+  exception_type_ = type;
+}
+
+void HTTPNeloBuilder::SetFileInfo(const base::FilePath& file_path,
+                                  FileFormat file_format,
+                                  bool is_crash_dump) {
+  file_path_ = file_path;
+  file_format_ = file_format;
+  is_crash_dump_ = is_crash_dump;
+}
+
+std::unique_ptr<HTTPBodyStream> HTTPNeloBuilder::GetBodyStream() {
+  // The objects inserted into this vector will be owned by the returned
+  // CompositeHTTPBodyStream. Take care to not early-return without deleting
+  // this memory.
+  std::vector<HTTPBodyStream*> streams;
+  base::DictValue dict;
+
+  // Mandatory fields.
+  dict.Set("Platform", base::Value(PLATFORM_NAME));
+  dict.Set("DmpData", base::Value(ReadFile()));
+  dict.Set("DmpFormat", base::Value(ToString(file_format_)));
+  dict.Set("DmpSymbol",
+              base::Value(is_crash_dump_ ? "Required" : "NotRequired"));
+  dict.Set("projectName", base::Value(nelo_project_name_));
+  dict.Set("projectVersion", base::Value(product_version_));
+
+  // Optional fields.
+  dict.Set("PlatformDetail", base::Value(base::JoinString(
+                                    {base::SysInfo::OperatingSystemName(),
+                                     base::SysInfo::OperatingSystemVersion()},
+                                    " ")));
+  dict.Set("logLevel", base::Value("FATAL"));
+  dict.Set("FileName", base::Value(file_path_.value()));
+
+  if (exception_type_ == ExceptionType::KernelCrash) {
+    dict.Set("ExceptionType", base::Value("KernelCrash"));
+  } else if (exception_type_ == ExceptionType::UpdateFailure) {
+    dict.Set("ExceptionType", base::Value("UpdateFailure"));
+  } else if (exception_type_ == ExceptionType::FirmwareError) {
+    dict.Set("ExceptionType", base::Value("FirmwareError"));
+  } else if (exception_type_ == ExceptionType::GpuError) {
+    dict.Set("ExceptionType", base::Value("GpuError"));
+  }
+
+  if (!annotations_.empty()) {
+    dict.Set("CustomMessage", base::Value(GetAnnotationsInJson()));
+  }
+  // Promote important fields from an annotation to a nelo field so that it can
+  // be indexed on nelo page.
+  if (auto* value = annotations_.FindString("ptype"))
+    dict.Set("ptype", base::Value(*value));
+  if (auto* value = annotations_.FindString("channel"))
+    dict.Set("channel", base::Value(*value));
+
+  // Merge |fields_| dictionary into |dict|.
+  for (const auto& field : fields_) {
+    // There should be no key conflicts.
+    DCHECK(dict.Find(field.first) == nullptr);
+    dict.Set(field.first, base::Value(field.second.Clone()));
+  }
+
+  std::string json;
+  bool result = base::JSONWriter::Write(dict, &json);
+  DCHECK(result);
+  streams.push_back(new StringHTTPBodyStream(json));
+
+  auto composite =
+      std::unique_ptr<HTTPBodyStream>(new CompositeHTTPBodyStream(streams));
+  return std::unique_ptr<HTTPBodyStream>(
+      new GzipHTTPBodyStream(std::move(composite)));
+}
+
+std::string HTTPNeloBuilder::GetAnnotationsInJson() const {
+  std::string json;
+  bool result = base::JSONWriter::Write(annotations_, &json);
+  DCHECK(result);
+  return json;
+}
+
+std::string HTTPNeloBuilder::ReadFile() const {
+  std::string contents;
+  // File max size is 32MB from nelo sdk.
+  // https://example.com
+  if (!base::ReadFileToStringWithMaxSize(file_path_, &contents, 32 << 20)) {
+    LOG(ERROR) << "File exceeds max size";
+    return std::string();
+  }
+  if (file_format_ == FileFormat::Text) {
+    return contents;
+  }
+  DCHECK(file_format_ == FileFormat::Bin);
+  std::string encoded = base::Base64Encode(contents);
+  return encoded;
+}
+
+void HTTPNeloBuilder::PopulateContentHeaders(HTTPHeaders* http_headers) const {
+  (*http_headers)[kContentEncoding] = "gzip";
+}
+}  // namespace util

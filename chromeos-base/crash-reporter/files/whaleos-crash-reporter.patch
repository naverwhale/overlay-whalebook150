+bool Sender::SendFileToNelo(const CrashDetails& details,
+                            const base::FilePath& file_path,
+                            const std::string& attached_log) {
+  bool dmp_symbol_require = true;
+  std::string version;
+  if (!details.metadata.GetString("ver", &version)) {
+    version = "unknown";
+  }
+
+  crashpad::HTTPNeloBuilder http_nelo_builder(kNeloProjectName, version);
+
+  crashpad::HTTPNeloBuilder::FileFormat format =
+      crashpad::HTTPNeloBuilder::FileFormat::Bin;
+  if (base::EndsWith(file_path.value(), kKernelCrashFileType)) {
+    dmp_symbol_require = false;
+    format = crashpad::HTTPNeloBuilder::FileFormat::Text;
+    http_nelo_builder.SetExceptionType(
+        crashpad::HTTPNeloBuilder::ExceptionType::KernelCrash);
+  } else if (base::EndsWith(file_path.value(), kLogFileType)) {
+    base::FilePath::StringType filename = file_path.BaseName().value();
+
+    // Log files are plain text and do not need symbolication.
+    dmp_symbol_require = false;
+    format = crashpad::HTTPNeloBuilder::FileFormat::Text;
+
+    // Check if the file is an update failure log.
+    if (base::StartsWith(filename, kUpdateFailurePrefix)) {
+      http_nelo_builder.SetExceptionType(
+          crashpad::HTTPNeloBuilder::ExceptionType::UpdateFailure);
     }
+  } else if (base::EndsWith(file_path.value(), kBertDumpFileType)) {
+    // A BERT dump is a raw ACPI firmware record (Boot Error Record Table), not
+    // a minidump, so there is no call stack to symbolicate. Leaving symbol
+    // resolution requested makes the server group every unsymbolizable dump
+    // under one empty stack hash, which merges unrelated firmware events into a
+    // single crash issue. The payload stays binary.
+    dmp_symbol_require = false;
+    http_nelo_builder.SetExceptionType(
+        crashpad::HTTPNeloBuilder::ExceptionType::FirmwareError);
+  } else if (base::EndsWith(file_path.value(), kTextFileType) &&
+             base::StartsWith(file_path.BaseName().value(),
+                              kBluetoothFirmwarePrefix)) {
+    // A Bluetooth device coredump is parsed into a plain-text summary of the
+    // controller firmware exception before it is uploaded (see
+    // UdevCollector::AppendBluetoothCoredump), so it is neither binary nor a
+    // minidump and has no call stack to symbolicate. The prefix is checked
+    // because ".txt" alone is too generic to identify the payload.
+    dmp_symbol_require = false;
+    format = crashpad::HTTPNeloBuilder::FileFormat::Text;
+    http_nelo_builder.SetExceptionType(
+        crashpad::HTTPNeloBuilder::ExceptionType::FirmwareError);
+  } else if (base::EndsWith(file_path.value(), kGzipLogFileType) &&
+             base::StartsWith(file_path.BaseName().value(), kDrmErrorPrefix)) {
+    // A drm/card0 udev error report is a gzipped dump of the i915 error state.
+    // It has no call stack to symbolicate, and it covers both real GPU hangs
+    // and forced captures with no hung engine, so it is classified rather than
+    // dropped to keep the trend observable. Every udev collection shares the
+    // ".log.gz" suffix, so the prefix is what identifies this one. The payload
+    // stays binary because it is gzip-compressed.
+    dmp_symbol_require = false;
+    http_nelo_builder.SetExceptionType(
+        crashpad::HTTPNeloBuilder::ExceptionType::GpuError);
+  }
+
+  http_nelo_builder.SetField("clientID", details.client_id);
+  // Embed the captured crash-time log so it shows up in the same NELO event as
+  // the call stack (see ReadAttachedCrashLog). Empty when no log is attached.
+  if (!attached_log.empty()) {
+    http_nelo_builder.SetAnnotation("crash_log", attached_log);
+  }
+  http_nelo_builder.SetFileInfo(file_path, format, dmp_symbol_require);
+
+  std::unique_ptr<crashpad::HTTPTransport> http_transport(
+      crashpad::HTTPTransport::Create());
+  crashpad::HTTPHeaders content_headers;
+  http_nelo_builder.PopulateContentHeaders(&content_headers);
+  for (const auto& content_header : content_headers) {
+    http_transport->SetHeader(content_header.first, content_header.second);
+  }
+  http_transport->SetBodyStream(http_nelo_builder.GetBodyStream());
+  // Nelo sdk uses 20 seconds timeout.
+  // https://example.com
+  http_transport->SetTimeout(20.0);
+  http_transport->SetURL(kNeloUploadURL);
+
+  std::string response_body;
+  return http_transport->ExecuteSynchronously(&response_body);
+}
 

+      .meta_file = system_dir.Append("0.0.0.0.0.meta"),
+      .payload_file = system_dir.Append(payload_file),
+      .payload_kind = "minidump",
+      .client_id = kFakeClientId,
+      .metadata = metadata,
+  };
+
+  Sender::Options options;
+  RecordingNeloSender sender(
+      nullptr, std::make_unique<test_util::AdvancingClock>(), options);
+
+  EXPECT_EQ(sender.RequestToSendCrashForTest(details),
+            SenderBase::CrashRemoveReason::kFinishedUploading);
+
+  ASSERT_EQ(sender.uploads.size(), 1u);
+  EXPECT_EQ(sender.uploads[0].file_path, system_dir.Append(payload_file));
+  EXPECT_TRUE(sender.uploads[0].attached_log.empty());
+}
+
+// When the payload is itself a log file (e.g. update_failure_*.log), there is
+// no call stack to pair with, so the crash log must not be embedded even if a
+// .log attachment happens to be present.
+TEST_F(CrashSenderUtilTest, RequestToSendCrashDoesNotEmbedLogIntoLogPayload) {
+  const base::FilePath system_dir = paths::Get(paths::kSystemCrashDirectory);
+  ASSERT_TRUE(base::CreateDirectory(system_dir));
+
+  const base::FilePath payload_file("update_failure_0.0.0.0.0.log");
+  ASSERT_TRUE(
+      test_util::CreateFile(system_dir.Append(payload_file), "fake_payload"));
+
+  const base::FilePath log_file("0.0.0.0.0.log");
+  ASSERT_TRUE(
+      test_util::CreateFile(system_dir.Append(log_file), "attached_log"));
+
+  brillo::KeyValueStore metadata;
+  metadata.SetString("ver", "fake_chromeos_ver");
+  metadata.SetString("upload_file_log", log_file.value());
+
+  CrashDetails details = {
+      .meta_file = system_dir.Append("0.0.0.0.0.meta"),
+      .payload_file = system_dir.Append(payload_file),
+      .payload_kind = "log",
+      .client_id = kFakeClientId,
+      .metadata = metadata,
+  };
+
+  Sender::Options options;
+  RecordingNeloSender sender(
+      nullptr, std::make_unique<test_util::AdvancingClock>(), options);
+
+  EXPECT_EQ(sender.RequestToSendCrashForTest(details),
+            SenderBase::CrashRemoveReason::kFinishedUploading);
+
+  // The log-payload is uploaded once, with no crash log embedded.
+  ASSERT_EQ(sender.uploads.size(), 1u);
+  EXPECT_EQ(sender.uploads[0].file_path, system_dir.Append(payload_file));
+  EXPECT_TRUE(sender.uploads[0].attached_log.empty());
+}
+
+// If the payload upload itself fails, the whole report must be retried.
+TEST_F(CrashSenderUtilTest, RequestToSendCrashRetriesWhenPayloadUploadFails) {
+  const base::FilePath system_dir = paths::Get(paths::kSystemCrashDirectory);
+  ASSERT_TRUE(base::CreateDirectory(system_dir));
+
+  const base::FilePath payload_file("0.0.0.0.0.dmp");
+  ASSERT_TRUE(
+      test_util::CreateFile(system_dir.Append(payload_file), "fake_dmp"));
+
+  // Sender subclass whose payload upload always fails.
+  class FailingNeloSender : public util::Sender {
+   public:
+    using util::Sender::Sender;
+
+    // Exposes the protected RequestToSendCrash() to the test body.
+    SenderBase::CrashRemoveReason RequestToSendCrashForTest(
+        const CrashDetails& details) {
+      return RequestToSendCrash(details);
+    }
+
+   protected:
+    bool SendFileToNelo(const CrashDetails& details,
+                        const base::FilePath& file_path,
+                        const std::string& attached_log) override {
+      return false;
+    }
+  };
+
+  brillo::KeyValueStore metadata;
+  metadata.SetString("ver", "fake_chromeos_ver");
+
+  CrashDetails details = {
+      .meta_file = system_dir.Append("0.0.0.0.0.meta"),
+      .payload_file = system_dir.Append(payload_file),
+      .payload_kind = "minidump",
+      .client_id = kFakeClientId,
+      .metadata = metadata,
+  };
+
+  Sender::Options options;
+  FailingNeloSender sender(
+      nullptr, std::make_unique<test_util::AdvancingClock>(), options);
+
+  EXPECT_EQ(sender.RequestToSendCrashForTest(details),
+            SenderBase::CrashRemoveReason::kRetryUploading);
+}

diff --git a/crash-reporter/update_failure_collector.cc b/crash-reporter/update_failure_collector.cc
new file mode 100644
index 0000000000..1f87672df9
--- /dev/null
+++ b/crash-reporter/update_failure_collector.cc
@@ -0,0 +1,129 @@
+// Copyright 2026 NAVER Corp. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "crash-reporter/update_failure_collector.h"
+
+#include <memory>
+#include <string>
+
+#include <base/files/file_path.h>
+#include <base/files/file_util.h>
+#include <base/functional/bind.h>
+#include <base/logging.h>
+#include <base/memory/ref_counted.h>
+#include <base/memory/scoped_refptr.h>
+#include <base/strings/stringprintf.h>
+#include <metrics/metrics_library.h>
+
+#include "crash-reporter/constants.h"
+#include "crash-reporter/crash_collection_status.h"
+#include "crash-reporter/crash_collector_names.h"
+#include "crash-reporter/util.h"
+
+namespace {
+const char kSignatureKey[] = "sig";
+const char kErrorTypeKey[] = "error_type";
+}  // namespace
+
+using base::FilePath;
+using base::StringPrintf;
+
+const char* const UpdateFailureCollector::kUpdateFailure = "update-failure";
+
+UpdateFailureCollector::UpdateFailureCollector(
+    const scoped_refptr<
+        base::RefCountedData<std::unique_ptr<MetricsLibraryInterface>>>&
+        metrics_lib)
+    : CrashCollector(CrashReporterCollector::kUpdateFailure, metrics_lib) {}
+
+UpdateFailureCollector::~UpdateFailureCollector() {}
+
+CrashCollectionStatus UpdateFailureCollector::Collect(
+    const std::string& module,
+    const std::string& error_type) {
+  LOG(INFO) << "Processing update failure: module=" << module
+            << " error_type=" << error_type;
+
+  // Build the exec_name: update_failure_module_error_type (e.g.,
+  // "update_failure_update_engine_PostinstallRunnerError")
+  std::string exec_name = StringPrintf("update_failure_%s_%s", module.c_str(),
+                                       error_type.c_str());
+
+  // Build the signature for NELO.
+  std::string signature = StringPrintf("update-failure-%s-%s",
+                                       module.c_str(), error_type.c_str());
+
+  FilePath crash_directory;
+  CrashCollectionStatus status = GetCreatedCrashDirectoryByEuid(
+      constants::kRootUid, &crash_directory, nullptr);
+  if (!IsSuccessCode(status)) {
+    return status;
+  }
+
+  std::string dump_basename = FormatDumpBasename(exec_name, time(nullptr), 0);
+  FilePath log_path = GetCrashPath(crash_directory, dump_basename, "log");
+  FilePath meta_path = GetCrashPath(crash_directory, dump_basename, "meta");
+
+  AddCrashMetaData(kSignatureKey, signature);
+  AddCrashMetaData(kErrorTypeKey, error_type);
+
+  // Use the log key based on the module name to pick up module-specific log
+  // capture commands from crash_reporter_logs.conf.
+  std::string log_key = StringPrintf("update-failure-%s", module.c_str());
+  status = GetLogContents(log_config_path_, log_key, log_path);
+
+  if (!IsSuccessCode(status)) {
+    // Fall back to the generic update-failure log key.
+    LOG(WARNING) << "Module-specific log key '" << log_key
+                 << "' not found, falling back to generic 'update-failure'";
+    status = GetLogContents(log_config_path_, kUpdateFailure, log_path);
+  }
+
+  if (!IsSuccessCode(status)) {
+    // Log collection failed, but we still want to report the failure to NELO.
+    // Write a placeholder log with basic error information.
+    LOG(WARNING) << "Failed to gather update failure logs, "
+                 << "creating placeholder report";
+    std::string placeholder = StringPrintf(
+        "update failure: module=%s error_type=%s\n"
+        "(log collection failed)\n",
+        module.c_str(), error_type.c_str());
+    if (WriteNewFile(log_path, placeholder) < 0) {
+      LOG(ERROR) << "Failed to write placeholder log file";
+      return CrashCollectionStatus::kFailureCreatingLogCollectionTmpFile;
+    }
+  }
+
+  return FinishCrash(meta_path, exec_name, log_path.BaseName().value());
+}
+
+CrashCollector::ComputedCrashSeverity UpdateFailureCollector::ComputeSeverity(
+    const std::string& exec_name) {
+  return {
+      .crash_severity = CrashSeverity::kError,
+      .product_group = Product::kPlatform,
+  };
+}
+
+// static
+CollectorInfo UpdateFailureCollector::GetHandlerInfo(
+    const HandlerInfoOptions& options,
+    const scoped_refptr<
+        base::RefCountedData<std::unique_ptr<MetricsLibraryInterface>>>&
+        metrics_lib) {
+  auto collector = std::make_shared<UpdateFailureCollector>(metrics_lib);
+  return {
+      .collector = collector,
+      .handlers = {
+          {
+              .should_handle = !options.update_failure.empty(),
+              .cb = base::BindRepeating(
+                  &UpdateFailureCollector::Collect,
+                  collector,
+                  options.update_failure,
+                  options.update_error_type),
+          },
+      },
+  };
+}
diff --git a/crash-reporter/update_failure_collector.h b/crash-reporter/update_failure_collector.h
new file mode 100644
index 0000000000..60345480ff
--- /dev/null
+++ b/crash-reporter/update_failure_collector.h
@@ -0,0 +1,67 @@
+// Copyright 2026 NAVER Corp. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The update failure collector collects OS update failure logs from
+// update_engine, installer (postinstall), and browser modules.
+// The flow looks like this:
+// 1. An update failure is detected by a module (update_engine, installer, or
+//    browser)
+// 2. The module invokes crash_reporter with --update_failure=<module>
+//    --update_error_type=<error_type>
+// 3. crash_reporter invokes UpdateFailureCollector to capture relevant logs
+//    and create a crash report for NELO upload.
+
+#ifndef CRASH_REPORTER_UPDATE_FAILURE_COLLECTOR_H_
+#define CRASH_REPORTER_UPDATE_FAILURE_COLLECTOR_H_
+
+#include <memory>
+#include <string>
+
+#include <base/memory/ref_counted.h>
+#include <base/memory/scoped_refptr.h>
+#include <metrics/metrics_library.h>
+
+#include "crash-reporter/crash_collector.h"
+
+enum class CrashCollectionStatus;
+
+// Collector for OS update failures from update_engine, installer, and browser.
+class UpdateFailureCollector : public CrashCollector {
+ public:

+
+#include "crash-reporter/crashpad/file_seeker.h"
+
+#include <base/logging.h>
+
+namespace crashpad {
+
+crashpad::FileOffset FileSeekerInterface::SeekGet() {
+  return Seek(0, SEEK_CUR);
+}
+
+bool FileSeekerInterface::SeekSet(crashpad::FileOffset offset) {
+  crashpad::FileOffset rv = Seek(offset, SEEK_SET);
+  if (rv < 0) {
+    // Seek() will have logged its own error.
+    return false;
+  } else if (rv != offset) {
+    LOG(ERROR) << "SeekSet(): expected " << offset << ", observed " << rv;
+    return false;
+  }
+  return true;
+}
+
+}  // namespace crashpad

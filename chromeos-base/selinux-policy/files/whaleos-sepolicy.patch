diff --git a/sepolicy/policy/chromeos/whaleos_waydroid.te b/sepolicy/policy/chromeos/whaleos_waydroid.te
new file mode 100644
index 0000000000..42e3b2f837
--- /dev/null
+++ b/sepolicy/policy/chromeos/whaleos_waydroid.te
@@ -0,0 +1,43 @@
+# SELinux domain for the WhaleOS-native Waydroid LXC payload.
+#
+# WhaleOS (a ChromeOS fork) integrates Waydroid directly via LXC 5.x,
+# independent of Google's ARC++/ARCVM stack.  Keep this domain in the
+# `whaleos_*` namespace to make that ownership explicit -- it does not
+# share lifecycle, code paths, or maintainership with cros_arc_*.
+#
+# /usr/lib/waydroid/bin/lxc-start (a Waydroid-only wrapper that
+# execs /usr/bin/lxc-start) is labeled whaleos_waydroid_exec.  The
+# waydroid-container / waydroid-session upstart jobs prepend the
+# wrapper directory to PATH, so Waydroid's Python helpers'
+# `subprocess.Popen(["lxc-start", ...])` resolve to the labeled
+# wrapper and only Waydroid invocations transition into this
+# domain.  /usr/bin/lxc-start itself is *not* labeled so other
+# LXC users on the host (e.g. dev-mode debugging containers) keep
+# their original domain and aren't pulled into ours.
+#
+# This gives us a single, targeted handle for granting host-resource
+# access (e.g. CRAS) instead of the previous shotgun `setenforce 0`.
+type whaleos_waydroid, domain, chromeos_domain, cros_miscdomain, mlstrustedsubject;
+
+# Start out permissive so any remaining denials surface as audit log
+# entries we can iterate on instead of breaking the container.  Drop
+# this line once we've collected and granted the full set.
+permissive whaleos_waydroid;
+
+# Transition into this domain when the waydroid-container upstart job
+# (running as cros_init / cros_init_scripts) execs lxc-start, and when
+# our root-only diagnostic / cleanup helpers exec it too.
+domain_auto_trans({cros_init cros_init_scripts chromeos}, whaleos_waydroid_exec, whaleos_waydroid)
+
+# CRAS client: container audioserver (uid 1041, inside Waydroid)
+# connects to /run/cras/.cras_socket via the LXC bind-mount that
+# 0006-cras-audio-support.patch sets up.  This grants the same
+# allow-set that any other ChromeOS CRAS client (e.g. cras_test_client)
+# already gets, scoped narrowly to this domain.
+cros_cras_client(whaleos_waydroid)
+
+# Inherited fds / log routing.  Mirrors what cros_arc_setup.te needs
+# so log messages from container init / fatal aborts surface in the
+# host's syslog instead of being silently dropped.
+allow whaleos_waydroid cros_init_scripts:fd use;
+log_writer(whaleos_waydroid)

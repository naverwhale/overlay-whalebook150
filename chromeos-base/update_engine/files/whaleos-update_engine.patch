+void UpdateAttempter::ReportUpdateFailureToCrashReporter(ErrorCode code) {
+  // Skip non-actionable error codes that don't represent real failures.
+  ErrorCode base_code = utils::GetBaseErrorCode(code);
+  if (base_code == ErrorCode::kSuccess ||
+      base_code == ErrorCode::kNoUpdate ||
+      base_code == ErrorCode::kOmahaUpdateDeferredPerPolicy ||
+      base_code == ErrorCode::kOmahaUpdateDeferredForBackoff ||
+      base_code == ErrorCode::kUserCanceled ||
+      base_code == ErrorCode::kOmahaUpdateIgnoredOverCellular ||
+      base_code == ErrorCode::kOmahaUpdateIgnoredOverMetered ||
+      base_code == ErrorCode::kUpdatedButNotActive ||
+      base_code == ErrorCode::kNonCriticalUpdateInOOBE ||
+      base_code == ErrorCode::kOmahaErrorInHTTPResponse ||
+      base_code == ErrorCode::kRepeatedFpFromOmahaError ||
+      base_code == ErrorCode::kUpdateIgnoredRollbackVersion ||
+      base_code == ErrorCode::kInvalidateLastUpdate ||
+      base_code == ErrorCode::kNonCriticalUpdateEnrollmentRecovery) {
+    return;
+  }
+
+  string error_type = chromeos_update_engine::utils::ErrorCodeToString(code);
+  // Strip "ErrorCode::k" prefix for consistent PascalCase naming across modules
+  // (e.g., "ErrorCode::kDownloadTransferError" -> "DownloadTransferError").
+  const string kErrorCodePrefix = "ErrorCode::k";
+  if (base::StartsWith(error_type, kErrorCodePrefix,
+                       base::CompareCase::SENSITIVE)) {
+    error_type = error_type.substr(kErrorCodePrefix.size());
+  }
+
+  vector<string> cmd = {
+      "/sbin/crash_reporter",
+      "--update_failure=update_engine",
+      base::StringPrintf("--update_error_type=%s", error_type.c_str()),
+  };
+
+  int exit_code = 0;
+  if (!Subprocess::SynchronousExec(cmd, &exit_code, nullptr, nullptr)) {
+    LOG(WARNING) << "Failed to invoke crash_reporter for update failure: "
+                 << error_type;
+  } else if (exit_code != 0) {
+    LOG(WARNING) << "crash_reporter exited with code " << exit_code
+                 << " for update failure: " << error_type;
+  } else {
+    LOG(INFO) << "Reported update failure to crash_reporter: " << error_type;
+  }
+}
